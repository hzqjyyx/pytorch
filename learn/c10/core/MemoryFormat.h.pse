--------------------------------
MemoryFormat (内存布局枚举与工具)
来源: c10/core/MemoryFormat.h
--------------------------------

【类型定义】
    enum MemoryFormat:
        Contiguous      # 连续布局 (NCHW)
        Preserve        # 保持输入格式
        ChannelsLast    # 通道优先2D (NHWC)
        ChannelsLast3d  # 通道优先3D (NDHWC)

【工具函数】
    get_contiguous_memory_format() -> MemoryFormat
        用途: 返回 Contiguous 格式

    get_channels_last_strides_2d<T>(sizes: ArrayRef<T>) -> vector<T>
        参数: sizes=张量形状
        用途: 计算 ChannelsLast 2D 的步幅
        算法:
            match sizes.size():
                4:  # NCHW -> NHWC
                    strides[1] = 1           # C
                    strides[3] = sizes[1]    # W
                    strides[2] = strides[3] * sizes[3]  # H
                    strides[0] = strides[2] * sizes[2]  # N
                3:  # CHW -> HWC
                    strides[0] = 1           # C
                    strides[2] = sizes[0]    # W
                    strides[1] = strides[2] * sizes[2]  # H
                _:
                    error("不支持的维度")

    get_channels_last_strides_3d<T>(sizes: ArrayRef<T>) -> vector<T>
        参数: sizes=张量形状
        用途: 计算 ChannelsLast 3D 的步幅
        算法:
            match sizes.size():
                5:  # NCDHW -> NDHWC
                    strides[1] = 1           # C
                    strides[4] = sizes[1]    # W
                    strides[3] = strides[4] * sizes[4]  # H
                    strides[2] = strides[3] * sizes[3]  # D
                    strides[0] = strides[2] * sizes[2]  # N
                4:  # CDHW -> DHWC
                    strides[0] = 1           # C
                    strides[3] = sizes[0]    # W
                    strides[2] = strides[3] * sizes[3]  # H
                    strides[1] = strides[2] * sizes[2]  # D
                _:
                    error("不支持的维度")

    is_channels_last_strides_2d<T>(sizes: ArrayRef<T>, strides: ArrayRef<T>) -> bool
        参数: sizes=张量形状, strides=张量步幅
        用途: 判断步幅是否符合 ChannelsLast 2D 格式
        算法:
            match sizes.size():
                4:
                    return is_channels_last_strides_2d_s4(sizes, strides)
                3:
                    return false  # 暂未启用
                _:
                    return false

    is_channels_last_strides_3d<T>(sizes: ArrayRef<T>, strides: ArrayRef<T>) -> bool
        参数: sizes=张量形状, strides=张量步幅
        用途: 判断步幅是否符合 ChannelsLast 3D 格式
        算法:
            match sizes.size():
                5:
                    return is_channels_last_strides_3d_s5(sizes, strides)
                4:
                    return false  # 暂未启用
                _:
                    return false

【核心检查逻辑】
    is_channels_last_strides_2d_s4<T>(sizes: ArrayRef<T>[4], strides: ArrayRef<T>[4]) -> bool
        用途: 检查4D张量是否为 ChannelsLast 格式
        算法:
            # 检查顺序: C(1) < W(3) < H(2) < N(0)
            if strides[1] == 0:  # C维步幅为0
                return false

            min = 0
            for d in [1, 3, 2, 0]:  # 按 ChannelsLast 顺序遍历
                if sizes[d] == 0:
                    return false
                if strides[d] < min:  # 步幅必须递增
                    return false
                
                # 特殊情况: N111 张量默认为 NCHW
                if d == 0 and min == strides[1]:
                    return false
                
                min = strides[d]
                if sizes[d] > 1:
                    min *= sizes[d]
            
            return true

    is_channels_last_strides_3d_s5<T>(sizes: ArrayRef<T>[5], strides: ArrayRef<T>[5]) -> bool
        用途: 检查5D张量是否为 ChannelsLast3d 格式
        算法:
            # 检查顺序: C(1) < W(4) < H(3) < D(2) < N(0)
            if strides[1] == 0:
                return false

            min = 0
            for d in [1, 4, 3, 2, 0]:
                if sizes[d] == 0:
                    return false
                if strides[d] < min:
                    return false
                if d == 0 and min == strides[1]:
                    return false
                
                min = strides[d]
                if sizes[d] > 1:
                    min *= sizes[d]
            
            return true

【备注】
    - ChannelsLast 格式通过步幅隐式表达，存在歧义性 (见 Note [Ambiguous is_channels_last_strides_xd])
    - 对于 N111 等退化形状，默认推断为 Contiguous 格式
    - 检查逻辑考虑了 size=1 维度的步幅，以区分真实的 ChannelsLast 和切片后的伪 ChannelsLast
    - 3D/4D 的部分维度组合暂未启用检查 (标记为 TODO)
