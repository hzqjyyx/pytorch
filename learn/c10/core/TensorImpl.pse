## 三、形状与步长操作

--------------------------------
set_sizes_and_strides (符号版本)
来源: TensorImpl.cpp
--------------------------------

【签名】
    set_sizes_and_strides(sizes: SymIntArrayRef, strides: SymIntArrayRef, storage_offset: optional<SymInt>)

【算法】
    int_sizes = asIntArrayRefSlowOpt(sizes)
    int_strides = asIntArrayRefSlowOpt(strides)

    if int_sizes and int_strides and 
       (not storage_offset or not storage_offset.is_heap_allocated()) and
       not has_symbolic_sizes_strides_:
        # 快速路径：全是具体整数
        set_sizes_and_strides(*int_sizes, *int_strides)
        if storage_offset:
            set_storage_offset(storage_offset.as_int_unchecked())
        return

    # 慢速路径：有符号整数
    assert allow_tensor_metadata_change()
    has_symbolic_sizes_strides_ = true
    refresh_sizes_strides_policy()

    if not extra_meta_:
        extra_meta_ = make_unique<ExtraMeta>()
        extra_meta_.symbolic_shape_meta_ = make_unique<SymbolicShapeMeta>()
        extra_meta_.symbolic_shape_meta_.strides_valid_ = not is_sparse()
        if not storage_offset:
            extra_meta_.symbolic_shape_meta_.storage_offset_ = storage_offset_

    sym_shape_meta = symbolic_shape_meta()
    clone_symvec(sizes, sym_shape_meta.sizes_)
    clone_symvec(strides, sym_shape_meta.strides_)
    if storage_offset:
        sym_shape_meta.storage_offset_ = storage_offset.clone()

    refresh_numel()
    refresh_contiguous()

【备注】
    - 优先使用具体整数的快速路径
    - 符号整数需要分配ExtraMeta存储

--------------------------------
generic_set_sizes_contiguous (符号版本)
来源: TensorImpl.cpp
--------------------------------

【签名】
    generic_set_sizes_contiguous(sizes: SymIntArrayRef)

【算法】
    int_sizes = asIntArrayRefSlowOpt(sizes)
    if int_sizes:
        set_sizes_contiguous(*int_sizes)
        return

    assert allow_tensor_metadata_change()
    has_symbolic_sizes_strides_ = true
    refresh_sizes_strides_policy()

    extra_meta = get_extra_meta()
    if extra_meta.symbolic_shape_meta_ == nullptr:
        extra_meta_.symbolic_shape_meta_ = make_unique<SymbolicShapeMeta>()
        extra_meta_.symbolic_shape_meta_.strides_valid_ = not is_sparse()

    clone_symvec(sizes, symbolic_shape_meta().sizes_)
    refresh_numel()
    empty_tensor_restride_symint(Contiguous)

--------------------------------
empty_tensor_restride_symint
来源: TensorImpl.cpp
--------------------------------

【签名】
    empty_tensor_restride_symint(memory_format: MemoryFormat)

【算法】
    assert has_symbolic_sizes_strides_
    sym_shape_meta = symbolic_shape_meta()

    match memory_format:
        Contiguous:
            dim_ = sym_shape_meta.dim()
            sym_shape_meta.strides_.resize(dim_)
            if dim_ > 0:
                last_idx = dim_ - 1
                sym_shape_meta.strides_[last_idx] = SymInt(1)
                for i in range(last_idx - 1, -1, -1):
                    sym_shape_meta.strides_[i] = sym_shape_meta.strides_[i+1] * 
                                sym_shape_meta.sizes_[i+1].max(1)

        ChannelsLast:
            assert dim() == 4
            clone_symvec(get_channels_last_strides_2d(sym_sizes()), sym_shape_meta.strides_)

        ChannelsLast3d:
            assert dim() == 5
            clone_symvec(get_channels_last_strides_3d(sym_sizes()), sym_shape_meta.strides_)

    refresh_contiguous()

    # 硬编码已知的连续性假设(用于unbacked符号整数)
    match memory_format:
        Contiguous:
            sym_shape_meta.assume_contiguous()
            sym_shape_meta.assume_non_overlapping_and_dense()
        ChannelsLast:
            sym_shape_meta.assume_channels_last_contiguous()
            sym_shape_meta.assume_channels_last()sym_shape_meta.assume_non_overlapping_and_dense()
        ChannelsLast3d:
            sym_shape_meta.assume_channels_last_3d_contiguous()
            sym_shape_meta.assume_channels_last_3d()
            sym_shape_meta.assume_non_overlapping_and_dense()

【备注】
    - 符号形状的步长计算使用SymInt::max(1)处理0维
    - assume_*方法用于为unbacked符号整数添加约束

