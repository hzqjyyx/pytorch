## 六、浅拷贝与元数据拷贝

--------------------------------
shallow_copy_and_detach_core
来源: TensorImpl.cpp
--------------------------------

【签名】
    shallow_copy_and_detach_core(version_counter: VariableVersion, allow_tensor_metadata_change: bool) -> intrusive_ptr<TensorImpl>

【算法】
    mode_stack_len = TorchDispatchModeTLS::stack_len()

    # 尝试Python自定义detach
    if mode_stack_len > 0 and not tls_is_dispatch_key_excluded(Python):
        cur_mode = TorchDispatchModeTLS::get_stack_at(mode_stack_len - 1)
        r = cur_mode.pyinterpreter().detach(this)else if key_set_.has(Python) and not tls_is_dispatch_key_excluded(Python):
        r = pyobj_slot_.load_pyobj_interpreter().detach(this)

    if r:
        if not r.is_inference():
            r.set_version_counter(forward(version_counter))
        r.set_allow_tensor_metadata_change(allow_tensor_metadata_change)
        return r

    # 默认实现：创建新TensorImpl并拷贝元数据
    impl = make_intrusive<TensorImpl>(key_set_, data_type_, device_opt_)
    copy_tensor_metadata(this, impl.get(), forward(version_counter), allow_tensor_metadata_change)
    return impl

【备注】
    - 优先调用Python自定义的detach
    - 默认实现不拷贝PyObject

--------------------------------
copy_tensor_metadata
来源: TensorImpl.cpp
--------------------------------

【签名】
    copy_tensor_metadata(src_impl: TensorImpl*, dest_impl: TensorImpl*, version_counter: VariableVersion, allow_tensor_metadata_change: bool)

【算法】
    copy_tensor_metadata_except_version_counter(src_impl, dest_impl, allow_tensor_metadata_change)
    if not dest_impl.is_inference():
        dest_impl.set_version_counter(version_counter)

【签名】
    copy_tensor_metadata_except_version_counter(src_impl: TensorImpl*, dest_impl: TensorImpl*, allow_tensor_metadata_change: bool)

【算法】
    copy_generic_tensor_metadata(src_impl, dest_impl)
    dest_impl.storage_ = src_impl.storage_
    # 保留dest的Python键，拷贝src的非Python键
    dest_impl.key_set_ = (src_impl.key_set_ - python_ks) | (
