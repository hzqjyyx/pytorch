_nan_to_num_replace (设备函数)
来源: aten/src/ATen/native/cuda/UnaryOpsKernel.cu:211-220
--------------------------------

【签名】
    @host @device
    _nan_to_num_replace<T>(
        a: T,
        nan_replacement: T,
        pos_inf_replacement: T,
        neg_inf_replacement: T
    ) -> T

【算法】
    if _isnan(a):
        return nan_replacement
    else if a == +inf:
        return pos_inf_replacement
    else if a == -inf:
        return neg_inf_replacement
    else:
        return a

--------------------------------
nan_to_num_kernel_cuda
来源: aten/src/ATen/native/cuda/UnaryOpsKernel.cu:222-262
--------------------------------

【签名】
    @host→device
    nan_to_num_kernel_cuda(
        iter: TensorIteratorBase,
        nan: Optional[double] = None,
        pos_inf: Optional[double] = None,
        neg_inf: Optional[double] = None
    )

【算法】
    if iter.dtype() is complex:
        # 对实部和虚部分别处理
        nan_repl = nan.value_or(0.0)
        posinf_repl = pos_inf.value_or(value_t::max())
        neginf_repl = neg_inf.value_or(value_t::lowest())
        
        gpu_kernel(iter, λ(a: complex_t) -> complex_t:
            real = _nan_to_num_replace(a.real(), nan_repl, posinf_repl, neginf_repl)
            imag = _nan_to_num_replace(a.imag(), nan_repl, posinf_repl, neginf_repl)
            return complex(real, imag)
        )
    else:
        # 浮点类型
        nan_repl = nan.value_or(0.0)
        posinf_repl = pos_inf.value_or(scalar_t::max())
        neginf_repl = neg_inf.value_or(scalar_t::lowest())
        
        gpu_kernel(iter, λ(a: scalar_t) -> scalar_t:
            return _nan_to_num_replace(a, nan_repl, posinf_repl, neginf_repl)
        )

【并行模式】
    elementwise

【备注】
    - 复数类型需对实部和虚部分别替换
    - 默认替换值: nan→0, +inf→max, -inf→lowest

