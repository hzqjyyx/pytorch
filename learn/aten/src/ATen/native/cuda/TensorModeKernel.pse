--------------------------------
mode_kernel_impl
来源: aten/src/ATen/native/cuda/TensorModeKernel.cpp
--------------------------------

【签名】
    mode_kernel_impl(
        values: Tensor[*],           # 输出: 众数值
        indices: Tensor[*, int64],   # 输出: 众数首次出现索引
        self: Tensor[*],             # 输入张量
        dim: int64,                  # 计算众数的维度
        keepdim: bool                # 是否保留维度
    )

【算法】
    # Step 1: 准备输出形状 (dim维度变为1)
    output_shape = self.shape
    output_shape[dim] = 1
    
    slice_size = self.size(dim)
    slices = self.numel / slice_size
    
    # Step 2: 调整输出张量维度
    if not keepdim:
        values.unsqueeze_(dim)
        indices.unsqueeze_(dim)
    
    at::native::resize_output(values, output_shape)
    at::native::resize_output(indices, output_shape)
    
    # Step 3: 退化情况 (dim维度长度为1)
    if slice_size == 1:
        values.copy_(self)
        indices.fill_(0)
        if not keepdim:
            values.squeeze_(dim)
            indices.squeeze_(dim)
        return
    
    # Step 4: 转置并连续化
    # 将 dim 移到最后一维，便于按行处理
    transposed = self.transpose(dim, self.dim - 1)
    contiguous = transposed.contiguous()
    
    values_transposed = values.transpose(dim, self.dim - 1)
    indices_transposed = indices.transpose(dim, self.dim - 1)
    
    # Step 5: 选择kernel实现
    if slice_size <= 2 * MAX_BLOCK_SIZE and
       slices <= MAX_GRID_SIZE³ and
       canUse32BitIndexMath(self):
        # 小规模: 使用融合kernel
        launch_fused_mode_kernel(
            values_transposed, indices_transposed, contiguous, 
            slice_size, slices)
    else:
        # 大规模: 使用Thrust实现
        if transposed.is_same(contiguous):
            contiguous = contiguous.clone()  # 避免修改原始数据
        
        launch_apply_mode_kernel(
            values_transposed, indices_transposed, contiguous, 
            dim, self.dim)
    
    # Step 6: 恢复维度
    if not keepdim:
        values.squeeze_(dim)
        indices.squeeze_(dim)

【备注】
    - MAX_BLOCK_SIZE: ROCm=256, CUDA=1024
    - MAX_GRID_SIZE: 65535 (compute capability >= 2.0)
    - 融合kernel适用于中小规模数据
    - Thrust实现适用于大规模或无法使用32位索引的情况

--------------------------------
launch_fused_mode_kernel
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    launch_fused_mode_kernel(
        values: Tensor[slices, 1, *],
        indices: Tensor[slices, 1, *, int64],
        self: Tensor[slices, slice_size, *],
        slice_size: int64,
        slices: int64
    )

【算法】
    AT_DISPATCH_ALL_TYPES_AND3(kBool, kBFloat16, kHalf, self.scalar_type(), "cuda_mode", [&] {
        fused_mode<scalar_t>(values, indices, self, slice_size, slices)
    })

【备注】
    - 类型分发到 fused_mode 模板函数
    - 支持所有数值类型、bool、bfloat16、half

--------------------------------
fused_mode<scalar_t>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    fused_mode<scalar_t>(
        values: Tensor[slices, 1, *],
        indices: Tensor[slices, 1, *, int64],
        self: Tensor[slices, slice_size, *],
        slice_size: int64,
        slices: int64
    )

【算法】
    # 创建TensorInfo用于kernel访问
    ti_values = cuda::detail::getTensorInfo<scalar_t, unsigned int>(values)
    ti_indices = cuda::detail::getTensorInfo<int64_t, unsigned int>(indices)
    
    # 计算grid配置: 每个block处理一个slice
    grid = getGridFromTiles(slices)
    
    # 计算block配置: 向上取2的幂次
    ceilPowerOf2 = nextHighestPowerOf2(slice_size)
    
    # 根据大小选择模板实例化
    match ceilPowerOf2:
        2048:
            handle_fused_mode<2048, scalar_t>(grid, self, ti_values, ti_indices, slice_size, slices)
        1024 | 512 | 256:
            handle_fused_mode<1024, scalar_t>(grid, self, ti_values, ti_indices, slice_size, slices)
        128 | 64 | 32 | 16 | 8 | 4 | 2:
            handle_fused_mode<128, scalar_t>(grid, self, ti_values, ti_indices, slice_size, slices)
        default:
            assert(false)

【并行模式】
    grid: (slices_x, slices_y, slices_z)  # 每个block处理一个slice
    block: size/2 threads                  # 每个线程处理2个元素

【备注】
    - 编译时间权衡: 仅实例化3个size模板 (2048, 1024, 128)
    - shared_memory: sizeof(scalar_t)*size + 2*size*sizeof(unsigned int)

--------------------------------
handle_fused_mode<size, scalar_t>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    handle_fused_mode<size, scalar_t>(
        grid: dim3,
        self: Tensor[slices, slice_size, *],
        ti_values: TensorInfo<scalar_t, unsigned int>,
        ti_indices: TensorInfo<int64_t, unsigned int>,
        slice_size: int64,
        slices: int64
    )

【算法】
    num_threads = size / 2
    warp_size = at::cuda::warp_size()
    
    # 验证配置
    assert num_threads % warp_size == 0
    assert num_threads <= cuda_utils::kCUDABlockReduceMaxThreads
    
    # 计算shared memory需求
    memsize = sizeof(scalar_t) * size + 2 * size * sizeof(unsigned int)
    
    # 启动kernel
    compute_mode<scalar_t, size>
        <<<grid, num_threads, memsize, at::cuda::getCurrentCUDAStream()>>>(
            self.const_data_ptr<scalar_t>(), 
            ti_values, 
            ti_indices, 
            slice_size, 
            slices)

【备注】
    - compute_mode: 定义在 TensorModeKernel.cuh 中的device kernel

