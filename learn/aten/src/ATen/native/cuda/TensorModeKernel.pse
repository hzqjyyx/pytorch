launch_apply_mode_kernel
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    launch_apply_mode_kernel(
        values: Tensor[*],
        indices: Tensor[*, int64],
        self: Tensor[*],           # 已连续化并转置
        dim: int64,
        ndim: int64
    )

【算法】
    AT_DISPATCH_ALL_TYPES_AND3(kBool, kBFloat16, kHalf, self.scalar_type(), "cuda_mode", [&] {
        position = vector<int64_t>(ndim - 1, 0)
        apply_mode<scalar_t>(values, indices, self, position, dim, 0)
    })

【备注】
    - 递归遍历除最后一维外的所有维度
    - position: 当前处理的多维索引

--------------------------------
apply_mode<scalar_t>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    apply_mode<scalar_t>(
        values: Tensor[*],
        indices: Tensor[*, int64],
        self: Tensor[*],           # 连续存储
        position: vector<int64_t>, # 当前多维索引
        dim: int64,
        curDim: int64              # 当前递归层级
    )

【算法】
    ndim = ensure_nonempty_dim(self.dim)
    
    if curDim == ndim - 1:
        # 到达最内层维度，计算该slice的mode
        calculate_mode<scalar_t>(values, indices, self, position, dim)
    else:
        # 递归遍历当前维度
        for i in range(self.size(curDim)):
            position[curDim] = i
            apply_mode<scalar_t>(values, indices, self, position, dim, curDim + 1)

【备注】
    - 递归深度: ndim - 1
    - 叶子节点调用 calculate_mode 处理一维数组

--------------------------------
calculate_mode<scalar_t>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    calculate_mode<scalar_t>(
        values: Tensor[*],
        indices: Tensor[*, int64],
        self: Tensor[*],           # 连续存储
        position: vector<int64_t>, # 目标slice的多维索引
        dim: int64
    )

【算法】
    # Step 1: 计算输入数据指针偏移
    data = self.mutable_data_ptr<scalar_t>()
    for i in range(position.size):
        data += position[i] * ensure_nonempty_stride(self, i)
    
    n_element = ensure_nonempty_size(self, self.dim - 1)
    iter_begin = data
    iter_end = data + n_element
    
    # Step 2: 调用Thrust实现计算mode
    (mode, index) = ModeImpl<scalar_t>{}(iter_begin, iter_end)
    
    # Step 3: 计算输出数据指针偏移
    values_data = values.mutable_data_ptr<scalar_t>()
    indices_data = indices.mutable_data_ptr<int64_t>()
    
    for i in range(position.size):
        values_data += ensure_nonempty_stride(values, i) * position[i]
        indices_data += ensure_nonempty_stride(indices, i) * position[i]
    
    # Step 4: 异步拷贝结果到device
    stream = at::cuda::getCurrentCUDAStream()
    AT_CUDA_CHECK(cudaMemcpyAsync(
        values_data, &mode, sizeof(scalar_t), cudaMemcpyHostToDevice, stream))
    at::cuda::memcpy_and_sync(
        indices_data, &index, sizeof(int64_t), cudaMemcpyHostToDevice, stream)

【备注】
    - 在host侧执行，每次处理一个一维slice
    - memcpy_and_sync: 同步等待结果拷贝完成

--------------------------------
ModeImpl<scalar_t>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    ModeImpl<scalar_t>::operator()(
        iter_begin: scalar_t*,
        iter_end: scalar_t*
    ) -> (scalar_t, int64_t)  # (众数值, 原始索引)

【算法】
    thrust_allocator = at::cuda::ThrustAllocator()
    stream = at::cuda::getCurrentCUDAStream()
    policy = thrust::cuda::par(thrust_allocator).on(stream)
    
    n_element = iter_end - iter_begin
    cuda_allocator = at::cuda::getCUDADeviceAllocator()
    
    # Step 1: 创建索引缓冲区 [0, 1, 2, ..., n-1]
    sort_buffer = c10::DeviceArray<int64_t>(cuda_allocator, n_element)
    sort_buffer_ptr = thrust::device_pointer_cast(sort_buffer.get())
    count_from_zero_iter = thrust::make_counting_iterator(0)
    thrust::copy_n(policy, count_from_zero_iter, n_element, sort_buffer_ptr)
    
    # Step 2: 排序数据，同时记录原始索引
    thrust::sort_by_key(policy, iter_begin, iter_end, sort_buffer_ptr)
    
    # Step 3: 统计唯一元素个数
    unique = 1 + thrust::inner_product(
        policy,
        iter_begin, iter_end - 1,
        iter_begin + 1,
        0,
        thrust::plus<int>(),
        thrust::not_equal_to<scalar_t>())
    
    # Step 4: 统计每个唯一值的频次
    keys = c10::DeviceArray<scalar_t>(cuda_allocator, unique)
    counts = c10::DeviceArray<int64_t>(cuda_allocator, unique)
    
    keys_ptr = thrust::device_pointer_cast(keys.get())
    counts_ptr = thrust::device_pointer_cast(counts.get())
    
    thrust::reduce_by_key(
        policy,
        iter_begin, iter_end,
        thrust::constant_iterator<int>(1),
        keys_ptr,
        counts_ptr)
    
    # Step 5: 找到最大频次对应的值
    it = thrust::max_element(policy, counts_ptr, counts_ptr + unique)
    mode = keys_ptr[it - counts_ptr]
    
    # Step 6: 找到该值在排序后数组中的位置
    position_iter = thrust::find(policy, iter_begin, iter_end, mode)
    
    # Step 7: 转换为原始未排序位置
    assert position_iter != iter_end
    index = sort_buffer_ptr[position_iter - iter_begin]
    
    return (mode, index)

【并行模式】
    - thrust::sort_by_key: 并行排序
    - thrust::inner_product: 并行计数唯一元素
    - thrust::reduce_by_key: 并行归约统计频次
    - thrust::max_element: 并行找最大值
    - thrust::find: 并行查找

【备注】
    - 算法复杂度: O(n log n) (排序主导)
    - 空间复杂度: O(n + unique)

--------------------------------
ModeImpl<bool>
来源: aten/src/ATen/native/cuda/TensorModeKernel.cu
--------------------------------

【签名】
    @host→device
    ModeImpl<bool>::operator()(
        first: const bool*,
        last: const bool*
    ) -> (bool, int64_t)  # (众数值, 首次出现索引)

【算法】
    thrust_allocator = at::cuda::ThrustAllocator()
    stream = at::cuda::getCurrentCUDAStream()
    policy = thrust::cuda::par(thrust_allocator).on(stream)
    
    # Step 1: 统计true的个数
    # NOTE: bool在内存中以uint8存储
    first_bytes = reinterpret_cast<const uint8_t*>(first)
    last_bytes = reinterpret_cast<const uint8_t*>(last)
    
    numel = last - first
    num_true = thrust::count_if(
        policy,
        first_bytes, last_bytes,
        [] GPU_LAMBDA (uint8_t x) {
            return static_cast<bool>(x)
        })
    
    # Step 2: 计算众数
    num_false = numel - num_true
    mode = num_true > num_false
    
    # Step 3: 找到首次出现位置
    position_iter = thrust::find_if(
        policy, first_bytes, last_bytes, EqualsMode{mode})
    index = position_iter - first_bytes
    
    return (mode, index)

【并行模式】
    - thrust::count_if: 并行统计
    - thrust::find_if: 并行查找

【备注】
    - bool类型优化: 只有两种值，跳过排序和归约
    - 算法复杂度: O(n)

