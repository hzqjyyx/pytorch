--------------------------------
poisson_cuda_kernel
来源: aten/src/ATen/native/cuda/Distributions.cu
--------------------------------

【签名】
    @device
    poisson_cuda_kernel<scalar_t>(ret: Tensor[*D], lambda: Tensor[*D], philox_args: PhiloxCudaState)

【算法】
    parallel_for (ret_val, lambda) in zip(ret, lambda):
        assert lambda >= 0
        
        seeds = at::cuda::philox::unpack(philox_args)
        curand_init(seeds[0], blockIdx.x * blockDim.x + threadIdx.x, seeds[1], &state)
        
        ret_val = curand_poisson(&state, lambda)

【并行模式】
    max_threads_per_block: 512
    min_blocks_per_sm: 2
    elementwise

【备注】
    - 使用 curandStatePhilox4_32_10_t 随机数生成器
    - curand_poisson: cuRAND 库函数

--------------------------------
curand_uniform_wrapper
来源: aten/src/ATen/native/cuda/Distributions.cu
--------------------------------

【签名】
    @device
    curand_uniform_wrapper(state: curandStatePhilox4_32_10_t&) -> float

【算法】
    val = curand(&state)
    MASK = (1 << 24) - 1
    DIVISOR = 1.0 / (1 << 24)
    return (val & MASK) * DIVISOR

【备注】
    - 将 32-bit 随机数转换为 [0, 1) 的浮点数
    - 使用 float 的 24-bit 有效数字

--------------------------------
binomial_cuda_kernel
来源: aten/src/ATen/native/cuda/Distributions.cu
--------------------------------

【签名】
    @device
    binomial_cuda_kernel<scalar_t>(iter: TensorIteratorBase, philox_args: PhiloxCudaState)

【算法】
    at::native::distribution_binary_kernel(iter, philox_args,
        lambda (state, count, prob):
            uniform_lambda = curand_uniform_wrapper(state)
            standard_uniform = BaseSampler<accscalar_t>(uniform_lambda)
            sample = sample_binomial<scalar_t, accscalar_t>(count, prob, standard_uniform)
            return sample
    )

【并行模式】
    elementwise

【备注】
    - sample_binomial: 定义在 aten/src/ATen/native/Distributions.h
    - accscalar_t: 累加精度类型

--------------------------------
gamma_cuda_kernel
来源: aten/src/ATen/native/cuda/Distributions.cu
--------------------------------

【签名】
    @device
    gamma_cuda_kernel<scalar_t>(ret: Tensor[*D], alpha: Tensor[*D], philox_args: PhiloxCudaState)

【算法】
    parallel_for (ret_val, alpha) in zip(ret, alpha):
        seeds = at::cuda::philox::unpack(philox_args)
        curand_init(seeds[0], blockIdx.x * blockDim.x + threadIdx.x, seeds[1], &state)
        
        uniform_lambda = lambda: curand_uniform(&state)
        standard_uniform = BaseSampler<accscalar_t>(uniform_lambda)
        
        normal_lambda = lambda: curand_normal(&state)
        standard_normal = BaseSampler<accscalar_t>(normal_lambda)
        
        sample = sample_gamma<scalar_t, accscalar_t>(alpha, standard_uniform, standard_normal)
        ret_val = max(sample, min_value)

【并行模式】
    max_threads_per_block: 256
    min_blocks_per_sm: 2
    elementwise

【备注】
    - sample_gamma: 定义在 aten/src/ATen/native/Distributions.h
    - 输出被截断到 min_value 以避免数值下溢

--------------------------------
launch_dirichlet_kernel
来源: aten/src/ATen/native/cuda/Distributions.cu
--------------------------------

【签名】
    @host→device
    launch_dirichlet_kernel(iter: TensorIteratorBase)

【算法】
    AT_DISPATCH_FLOATING_TYPES_AND2(Half, BFloat16, iter.input_dtype(), "dirichlet_cuda", [&] {
        at::native::gpu_kernel(iter,
            lambda (gamma, gamma_sum):
                ret_val = gamma / gamma_sum
                ret_val = clamp(ret_val, min_value, max_value)
                return ret_val
        )
    })

    其中:
        min_value = std::numeric_limits<scalar_t>::min()
        max_value = 1 - std::numeric_limits<scalar_t>::epsilon()

【并行模式】
    elementwise

【备注】
    - 归一化后裁剪到 (min_value, max_value) 以避免 0 或 1

