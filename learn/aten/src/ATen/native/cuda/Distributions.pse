--------------------------------
_s_poisson_cuda
来源: aten/src/ATen/native/cuda/Distributions.cpp
--------------------------------

【签名】
    _s_poisson_cuda(lambda: Tensor[*D, float], gen: Optional[Generator]) -> Tensor[*D]

【算法】
    gen = get_generator_or_default<CUDAGeneratorImpl>(gen, cuda::detail::getDefaultCUDAGenerator())
    ret = at::empty(lambda.sizes(), lambda.options())
    launch_poisson_cuda_kernel(ret, lambda, gen)
    return ret

