## 【代码模板常量】

### jit_preamble / jit_epilogue
```
# ROCm 需要强制 __host__ __device__ 属性
if USE_ROCM:
    jit_preamble = R"ESCAPE(
        #pragma clang force_cuda_host_device begin
    )ESCAPE"
    jit_epilogue = R"ESCAPE(
        #pragma clang force_cuda_host_device end
    )ESCAPE"
else:
    jit_preamble = ""
    jit_epilogue = ""
```

### jit_common_types
```
包含:
    - MAX_DIMS, CUDA_OR_ROCM_NUM_THREADS 常量定义
    - int64_t, uint32_t, int8_t, uint8_t, int16_t 类型定义
    - ScalarType 枚举
    - Array<T, size> 模板（设备端固定大小数组）
    - AT_FORALL_SCALAR_TYPES_WITH_COMPLEX 宏
    - ${half_string}, ${bfloat16_string}, ${complex_body_string} 占位符
```

### jiterator_half_support_literal
```
定义 at::Half 结构:
    struct alignas(2) Half {
        unsigned short x;
        
        __host__ __device__ Half(float value) {
            # CUDA: PTX 内联汇编
            asm("{  cvt.rn.f16.f32 %0, %1;}\n" : "=h"(x) : "f"(value));
            # ROCm: __float2half
        }
        
        __host__ __device__ operator float() const {
            # CUDA: PTX 内联汇编
            asm("{  cvt.f32.f16 %0, %1;}\n" : "=f"(val) : "h"(x));
            # ROCm: __half2float
        }
    }
```

### jiterator_bfloat16_support_literal
```
定义 at::BFloat16 结构:
    struct alignas(2) BFloat16 {
        unsigned short x;
        
        __host__ __device__ BFloat16(float value) {
            # CUDA Ampere+: 硬件指令
            if __CUDA_ARCH__ >= 800:
                asm("{  cvt.rn.bf16.f32 %0, %1;}\n" : "=h"(x) : "f"(value));
            else:
                # 软件舍入
                x = __internal_float2bfloat16(value, sign, remainder)
                if remainder > 0x80000000 or (remainder == 0x80000000 and x & 0x1):
                    x++
        }
        
        __host__ __device__ operator float() const {
            # CUDA: 位操作
            asm("{ mov.b32 %0, {0,%1};}\n" : "=f"(val) : "h"(x));
            # ROCm: 联合体转换
        }
    }
```

### load_support_literal
```
定义 c10::load 模板:
    template <typename T>
    struct LoadImpl {
        __device__ static T apply(const void *src) {
            return *reinterpret_cast<const T*>(src);
        }
    };
    
    # bool 特化（避免未定义行为）
    template <>
    struct LoadImpl<bool> {
        __device__ static bool apply(const void *src) {
            return LoadImpl<char>::apply(src);
        }
    };
```

### dynamic_cast_support_literal
```
定义动态类型转换工具:
    - is_complex<T> trait
    - static_cast_with_inter_type<dest_t, src_t>（处理复数到实数转换）
    - fetch_and_cast<dest_t>(src_type: ScalarType, ptr: void*) -> dest_t
    - cast_and_store<src_t>(dest_type: ScalarType, ptr: void*, value: src_t)
    - LoadWithCast<N> / StoreWithCast<N> 模板

关键逻辑:
    # uint8_t 需要中间类型 int64_t（避免溢出）
    template <>
    struct static_cast_with_inter_type<uint8_t, src_t> {
        static uint8_t apply(src_t src) {
            return static_cast<uint8_t>(static_cast<int64_t>(maybe_real<real, src_t>::apply(src)));
        }
    };
    
    # complex<Half> 特殊处理
    template <>
    struct static_cast_with_inter_type<std::complex<at::Half>, at::Half> {
        static std::complex<at::Half> apply(at::Half src) {
            return static_cast<std::complex<at::Half>>(float{src});
        }
    };
```

### no_dynamic_cast_support_literal
```
定义无类型转换版本:
    struct LoadWithoutCast {
        template <typename scalar_t>
        __device__ scalar_t load(char* base_ptr, uint32_t offset, int arg=0) {
            return c10::load(reinterpret_cast<scalar_t*>(base_ptr) + offset);
        }
    };
    
    struct StoreWithoutCast {
        template<typename scalar_t>
        __device__ void store(scalar_t value, char *base_ptr, uint32_t offset, int arg=0) {
            *(reinterpret_cast<scalar_t *>(base_ptr) + offset) = value;
        }
    };
```

### offset_calc_template
```
定义偏移计算工具:
    - IntDivider（快速整数除法，使用魔数优化）
    - TrivialOffsetCalculator<NARGS>（连续内存，线性索引）
    - OffsetCalculator<NARGS>（非连续内存，步幅计算）

TrivialOffsetCalculator 算法:
    Array<index_type, NARGS> get(linear_idx: index_type) const {
        Array<index_type, NARGS> offsets;
        #pragma unroll
        for arg in range(NARGS):
            offsets[arg] = linear_idx
        return offsets
    }

OffsetCalculator 算法:
    Array<index_type, NARGS> get(linear_idx: index_type) const {
        Array<index_type, NARGS> offsets = {0, ...}
        
        #pragma unroll
        for dim in range(MAX_DIMS):
            if dim == dims:
                break
            
            divmod = sizes_[dim].divmod(linear_idx)
            linear_idx = divmod.div
            
            #pragma unroll
            for arg in range(NARGS):
                offsets[arg] += divmod.mod * strides_[dim][arg]
        
        return offsets
    }
```

### jit_code_template (Pointwise)
```
Kernel 签名:
    extern "C" __global__
    void ${name}_kernel(
        const int numel,
        Array<char*, ${nInputs}+${nOutputs}> data,
        ${offset_calculator}<${nInputs}> input_calculator,
        ${offset_calculator}<${nOutputs}> output_calculator,
        ${loader} l,
        ${storer} s,
        ${compute_type} scalar_val${extra_params}
    )

执行流程:
    # 局部数组
    ${declare_load_arrays}
    ${declare_store_arrays}
    
    idx = blockIdx.x
    remaining = numel - block_work_size * idx
    thread_idx = threadIdx.x
    
    # Load phase
    #pragma unroll
    for j in range(thread_work_size):
        if thread_idx >= remaining:
            break
        
        linear_idx = thread_idx + block_work_size * idx
        input_offsets = input_calculator.get(linear_idx)
        ${load_inputs}
        thread_idx += num_threads
    
    # Compute phase
    #pragma unroll
    for j in range(thread_work_size):
        if (threadIdx.x + j*num_threads) < remaining:
            ${call_functor}
    
    # Store phase
    thread_idx = threadIdx.x
    #pragma unroll
    for j in range(thread_work_size):
        if thread_idx >= remaining:
            break
        
        linear_idx = thread_idx + block_work_size * idx
        output_offsets = output_calculator.get(linear_idx)
        ${store_outputs}
        thread_idx += num_threads
```

### jit_vectorized_code_template
```
Kernel 签名:
    extern "C" __global__
    void ${name}_vectorized${vec_size}_kernel(
        const int N,
        Array<char*, ${nInputs}+${nOutputs}> data,
        ${compute_type} scalar_val${extra_params}
    )

执行流程:
    constexpr vec_size = ${vec_size}
    using scalar_t = ${scalar_type}
    
    remaining = N - block_work_size * blockIdx.x
    
    if remaining < block_work_size:
        # 非完整块：标量路径
        ${load_unrolled_inputs}
        ${call_functor}
        ${store_unrolled_outputs}
    else:
        # 完整块：向量化路径
        constexpr loop_size = thread_work_size / vec_size
        
        # 向量化 load
        ${vector_inputs}
        #pragma unroll
        for i in range(loop_size):
            ${load_vectorized_inputs}
            thread_idx += num_threads
        
        # 计算
        #pragma unroll
        for j in range(thread_work_size):
            ${call_functor}
        
        # 向量化 store
        ${vector_outputs}
        thread_idx = threadIdx.x
        #pragma unroll
        for i in range(loop_size):
            vec_t_output v
            ${store_vectorized_outputs}
            thread_idx += num_threads
```

