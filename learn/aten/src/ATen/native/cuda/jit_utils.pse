## 【编译与缓存】

### get_cache_dir
```
get_cache_dir() -> Optional[string]

用途: 获取或创建 kernel 缓存目录
算法:
    # Step 1: 检查是否禁用缓存
    use_kernel_cache = getenv("USE_PYTORCH_KERNEL_CACHE")
    if use_kernel_cache == "0":
        return None
    
    # Step 2: 确定缓存路径
    if (ptkcp = getenv("PYTORCH_KERNEL_CACHE_PATH")) != null:
        cache_dir = ptkcp
        kernels_cache_dir = ""
    elif (ptkcp = getenv("TEMP" if WIN32 else "XDG_CACHE_HOME")) != null:
        cache_dir = ptkcp + "/torch/kernels"
        kernels_cache_dir = "/torch/kernels"
    elif (ptkcp = getenv("HOME")) != null:
        cache_dir = ptkcp + "/.cache/torch/kernels"
        kernels_cache_dir = "/.cache/torch/kernels"
    else:
        warn("No cache path available, caching disabled")
        return None
    
    # Step 3: 创建目录（如果不存在）
    if not exists(cache_dir):
        if not r_mkdir_with_base(ptkcp, kernels_cache_dir):
            warn("Cannot create cache directory")
            return None
    
    # Step 4: 检查读写权限
    if not readable(cache_dir) or not writable(cache_dir):
        warn("Cache directory not accessible")
        return None
    
    return cache_dir

依赖:
    - access(), mkdir()    # 文件系统操作
```

### codegenOutputQuery
```
codegenOutputQuery(
    prop: cudaDeviceProp*,
    out cuda_major: int,
    out cuda_minor: int,
    out nvrtc_major: int,
    out nvrtc_minor: int,
    out compile_to_sass: bool
)

用途: 查询编译目标架构（PTX vs SASS）
参数:
    - prop: GPU 设备属性
    - cuda_major/minor: 目标 CUDA 计算能力
    - nvrtc_major/minor: NVRTC 版本
    - compile_to_sass: 是否编译到 SASS（需 CUDA 11.1+）

算法:
    nvrtcVersion(&nvrtc_major, &nvrtc_minor)
    
    if USE_ROCM:
        cuda_major = prop->major
        cuda_minor = prop->minor
        compile_to_sass = false
    else:
        dev_version = (prop->major, prop->minor)
        
        # 查询 NVRTC 支持的最大设备版本
        if nvrtc_major <= 7:
            max_dev_version = (5, 0)
        elif nvrtc_major <= 8:
            max_dev_version = (6, 0)
        elif nvrtc_major <= 9:
            max_dev_version = (7, 2)
        elif nvrtc_major <= 10:
            max_dev_version = (7, 5)
        elif nvrtc_version == (11, 0):
            max_dev_version = (8, 0)
        elif nvrtc_major == 11 and nvrtc_minor < 8:
            max_dev_version = (8, 6)
        else:
            max_dev_version = dev_version
        
        if dev_version > max_dev_version:
            cuda_major, cuda_minor = max_dev_version
            compile_to_sass = false  # 降级到 PTX
        else:
            cuda_major, cuda_minor = dev_version
            compile_to_sass = (CUDA_VERSION >= 11010)
```

### jit_pwise_function
```
jit_pwise_function(
    code: string,
    kernel_name: string
) -> NvrtcFunction

用途: JIT 编译或从缓存加载 pointwise kernel
算法:
    initializeCudaContext()
    prop = getCurrentDeviceProperties()
    codegenOutputQuery(prop, cuda_major, cuda_minor, nvrtc_major, nvrtc_minor, compile_to_sass)
    
    name = kernel_name + "_kernel"
    cache_dir = get_cache_dir()
    
    # Step 1: 尝试从缓存加载
    if cache_dir.has_value():
        hash_code = sha1(code).str()
        file_path = f"{cache_dir}/{kernel_name}_arch{cuda_major}.{cuda_minor}_nvrtc{nvrtc_major}.{nvrtc_minor}_{'sass' if compile_to_sass else 'ptx'}_{len(code)}_{hash_code}"
        
        if exists(file_path):
            buffer = read_binary(file_path)
            cuModuleLoadData(&compiled_kernel.module, buffer.data())
            cuModuleGetFunction(&compiled_kernel.function, compiled_kernel.module, name)
            return compiled_kernel
    
    # Step 2: JIT 编译
    nvrtcCreateProgram(&program, code, ...)
    
    compute = f"--gpu-architecture={'sm' if compile_to_sass else 'compute'}_{cuda_major}{cuda_minor}"
    args = ["--std=c++17", compute, "-default-device"]
    
    if DEBUG:
        args.append("-lineinfo")
    else:
        args.append("-DNDEBUG")
    
    if nvrtcCompileProgram(program, args) != SUCCESS:
        logsize = nvrtcGetProgramLogSize(program)
        log = nvrtcGetProgramLog(program, logsize)
        throw runtime_error(code + log)
    
    # 获取 PTX/SASS
    getSize = nvrtcGetCUBINSize if compile_to_sass else nvrtcGetPTXSize
    getFunc = nvrtcGetCUBIN if compile_to_sass else nvrtcGetPTX
    
    getSize(program, &ptx_size)
    ptx.resize(ptx_size)
    getFunc(program, ptx.data())
    
    cuModuleLoadData(&compiled_kernel.module, ptx.data())
    cuModuleGetFunction(&compiled_kernel.function, compiled_kernel.module, name)
    nvrtcDestroyProgram(&program)
    
    # Step 3: 写入缓存
    if cache_dir.has_value():
        tmp_file_path = f"{file_path}_tmp_{getpid()}"
        write_binary(tmp_file_path, ptx)
        rename(tmp_file_path, file_path)  # 原子替换
    
    return compiled_kernel

依赖:
    - nvrtc.nvrtcCreateProgram / nvrtcCompileProgram
    - nvrtc.cuModuleLoadData / cuModuleGetFunction
    - c10::sha1                        # SHA1 哈希
```

