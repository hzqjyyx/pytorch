# ATen JIT 工具模块 (CUDA Kernel 动态编译)

来源: aten/src/ATen/native/cuda/jit_utils.cpp, jit_utils.h

---

## 【概述】

该模块提供 CUDA/ROCm kernel 的运行时编译（JIT）功能，包括：
- NVRTC/HIP 代码生成
- 内核缓存管理
- 类型系统与向量化支持

---

## 【核心数据结构】

### NvrtcFunction
```
struct NvrtcFunction:
    module: CUmodule           # 编译后的模块句柄
    function: CUfunction       # kernel 函数指针
```

### KernelDescriptor
```
struct KernelDescriptor:
    name: string               # kernel 名称
    f: string                  # functor 代码字符串
    f_inputs_type: ScalarType  # 输入张量类型
    result_type: ScalarType    # 输出张量类型
    extra_args_types: SmallVector[ScalarType]  # 额外参数类型列表
    nInputs: int               # 输入张量数
    nOutputs: int              # 输出张量数
```

### BinaryFuncVariant (枚举)
```
enum BinaryFuncVariant:
    NoScalar      # 无标量，所有参数为张量
    RhsScalar     # 右操作数为标量
    LhsScalar     # 左操作数为标量
```

---

## 【工具函数】

### make_kernel_descriptor
```
make_kernel_descriptor<result_type, f_inputs_type, ...ExtraArgs>(
    name: string,
    f: string,
    nInputs: int,
    nOutputs: int
) -> KernelDescriptor

用途: 构造 KernelDescriptor，自动推导类型信息
```

### can_vectorize_up_to (重载1)
```
can_vectorize_up_to(
    default_alignment: size_t,
    pointer: void*
) -> int

用途: 检测指针对齐级别，返回可向量化宽度 (1/2/4/8/16)
算法:
    ip = reinterpret_cast<uintptr_t>(pointer)
    
    # ROCm 特殊处理
    if USE_ROCM:
        if default_alignment == 1 and ip % 16 == 0:
            return 16
        if default_alignment <= 2 and ip % (8 * default_alignment) == 0:
            return 8
    else:
        if ip % (8 * default_alignment) == 0:
            return 8
    
    # 通用检测
    if ip % (4 * default_alignment) == 0:
        return 4
    if ip % (2 * default_alignment) == 0:
        return 2
    return 1
```

### can_vectorize_up_to (重载2)
```
can_vectorize_up_to(
    desc: KernelDescriptor,
    pointers: ArrayRef[char*]
) -> int

用途: 检测所有输入输出指针的最小对齐级别
约束:
    - desc.nOutputs == 1
    - pointers.size == 1 + desc.nInputs

算法:
    result_size = scalarTypeToTypeMeta(desc.result_type).itemsize()
    result = can_vectorize_up_to(result_size, pointers[0])
    
    input_size = scalarTypeToTypeMeta(desc.f_inputs_type).itemsize()
    for i in range(1, pointers.size):
        result = min(result, can_vectorize_up_to(input_size, pointers[i]))
    
    return result
```

### calc_io_size
```
calc_io_size(
    nInputs: int,
    nOutputs: int,
    inputs_type: ScalarType,
    result_type: ScalarType
) -> int

用途: 计算 I/O 最小元素大小（用于向量化决策）
算法:
    if nInputs > 0 and nOutputs > 0:
        return min(elementSize(inputs_type), elementSize(result_type))
    if nInputs > 0:
        return elementSize(inputs_type)
    if nOutputs > 0:
        return elementSize(result_type)
    return 0
```

### calc_thread_work_size
```
calc_thread_work_size(
    nInputs: int,
    nOutputs: int,
    inputs_type: ScalarType,
    result_type: ScalarType
) -> int

用途: 计算每线程工作量（单位：元素数）
算法:
    io_size = calc_io_size(nInputs, nOutputs, inputs_type, result_type)
    assert io_size > 0
    
    if USE_ROCM:
        if io_size == 1:
            return 16
        elif io_size < 4:
            return 8
        else:
            return 4
    else:  # CUDA
        if io_size == 1:
            return 16
        else:
            return 8
```

---

## 【代码生成】

### generate_code (Pointwise)
```
generate_code(
    nInputs: int,
    nOutputs: int,
    func: string,                      # functor 代码
    name: string,                      # kernel 名称
    f_inputs_type: string,             # 输入类型名
    compute_type: string,              # 计算类型名
    result_type: string,               # 输出类型名
    contiguous: bool,                  # 是否连续内存
    dynamic_casting: bool,             # 是否需要动态类型转换
    scalar_pos: BinaryFuncVariant,     # 标量位置
    extra_args_typenames: SmallVector[string],
    thread_work_size: int = JIT_THREAD_WORK_SIZE,
    vectorized: bool = false,
    vec_size: int = 0,
    return_by_ref: bool = false        # 多输出时是否用引用返回
) -> string

用途: 生成 pointwise kernel 的 CUDA 代码
参数:
    - contiguous: 决定用 TrivialOffsetCalculator 还是 OffsetCalculator
    - dynamic_casting: 决定用 LoadWithCast/StoreWithCast 还是无类型转换版本
    - vectorized: 决定用向量化模板还是标量模板
    - return_by_ref: 决定 functor 调用方式（out = f(...) vs f(..., out)）

算法:
    env = TemplateEnv()
    
    # Step 1: 设置基础参数
    env.s("index_type", "unsigned int")
    env.s("nInputs", nInputs)
    env.s("nOutputs", nOutputs)
    env.s("scalar_type", f_inputs_type)
    env.s("compute_type", compute_type)
    env.s("functor", func)
    env.s("name", name)
    env.s("thread_work_size", thread_work_size)
    
    # Step 2: 生成额外参数（如 polygamma 的 n）
    extra_params = ""
    extra_args = ""
    for i, type in enumerate(extra_args_typenames):
        name = f"extra_arg_{i}"
        extra_params += f", {type} {name}"
        extra_args += f", {name}"
    env.s("extra_params", extra_params)
    env.s("extra_args", extra_args)
    
    # Step 3: 生成局部数组声明
    declare_load_arrays = ""
    for i in range(nInputs):
        declare_load_arrays += f"{f_inputs_type} arg{i}[{thread_work_size}];\n"
    
    declare_store_arrays = ""
    for i in range(nOutputs):
        declare_store_arrays += f"{result_type} out{i}[{thread_work_size}];\n"
    
    # Step 4: 生成 functor 调用
    if scalar_pos == NoScalar:
        functor_args = ", ".join(f"arg{i}[j]" for i in range(nInputs))
    elif scalar_pos == LhsScalar:
        functor_args = "scalar_val, arg0[j]"
    else:  # RhsScalar
        functor_args = "arg0[j], scalar_val"
    
    if return_by_ref:
        # 多输出情况
        functor_outs = ", ".join(f"out{i}[j]" for i in range(nOutputs))
        if compute_type != result_type:
            # 需要临时变量
            call_functor = f"{compute_type} {temp_outs};\n"
            call_functor += f"{name}<{compute_type}>({functor_args}{extra_args}, {temp_outs});\n"
            call_functor += "\n".join(f"out{i}[j] = temp_out{i};" for i in range(nOutputs))
        else:
            call_functor = f"{name}<{compute_type}>({functor_args}{extra_args}, {functor_outs});"
    else:
        # 单输出情况
        call_functor = f"out0[j] = {name}<{compute_type}>({functor_args}{extra_args});"
    
    env.s("call_functor", call_functor)
    
    # Step 5: 设置类型支持字符串
    if f_inputs_type in ["at::Half", "std::complex<at::Half>"] or \
       result_type in ["at::Half", "std::complex<at::Half>"] or \
       dynamic_casting:
        env.s("half_string", jiterator_half_support_literal)
    else:
        env.s("half_string", "")
    
    if f_inputs_type == "at::BFloat16" or result_type == "at::BFloat16" or dynamic_casting:
        env.s("bfloat16_string", jiterator_bfloat16_support_literal)
    else:
        env.s("bfloat16_string", "")
    
    if f_inputs_type in ["std::complex<float>", "std::complex<double>", "std::complex<at::Half>"] or \
       result_type in ["std::complex<float>", "std::complex<double>", "std::complex<at::Half>"]:
        env.s("traits_string", get_traits_string_but_hiprtc_safe())
        env.s("complex_body_string", get_complex_body_string())
        env.s("complex_math_string", get_complex_math_string())
        if USE_ROCM:
            func = unhipify_math_functions(func)
            env.s("functor", func)
    elif dynamic_casting:
        env.s("traits_string", get_traits_string_but_hiprtc_safe())
        env.s("complex_body_string", get_complex_body_string())
        env.s("complex_math_string", "")
    else:
        env.s("traits_string", "")
        env.s("complex_body_string", "")
        env.s("complex_math_string", "")
    
    if f_inputs_type == "std::complex<at::Half>" or \
       result_type == "std::complex<at::Half>" or \
       dynamic_casting:
        env.s("complex_half_body_string", get_complex_half_body_string())
    else:
        env.s("complex_half_body_string", "")
    
    env.s("load_support", load_support_literal)
    
    # Step 6: 选择模板
    if not vectorized:
        # 标量模板
        if dynamic_casting:
            env.s("loader", f"LoadWithCast<{nInputs}>")
            env.s("storer", f"StoreWithCast<{nOutputs}>")
            env.s("dynamic_casting_string", dynamic_cast_support_literal)
        else:
            env.s("loader", "LoadWithoutCast")
            env.s("storer", "StoreWithoutCast")
            env.s("dynamic_casting_string", no_dynamic_cast_support_literal)
        
        if contiguous:
            env.s("offset_calculator", "TrivialOffsetCalculator")
        else:
            env.s("offset_calculator", "OffsetCalculator")
        
        # 生成 load/store 代码
        load_inputs = ""
        for i in range(nInputs):
            load_inputs += f"arg{i}[j] = l.load<{f_inputs_type}>(data[{i+nOutputs}], input_offsets[{i}], {i});\n"
        
        store_outputs = ""
        for i in range(nOutputs):
            store_outputs += f"s.store<{result_type}>(out{i}[j], data[{i}], output_offsets[{i}], {i});\n"
        
        env.s("load_inputs", load_inputs)
        env.s("store_outputs", store_outputs)
        
        template = jit_preamble + jit_common_types + offset_calc_template + jit_code_template + jit_epilogue
        return CodeTemplate(template).format(env)
    
    else:
        # 向量化模板
        env.s("vec_size", vec_size)
        env.s("result_type", result_type)
        
        # 生成向量化 load/store 代码（省略细节）
        ...
        
        template = jit_preamble + jit_common_types + jit_vectorized_code_template + jit_epilogue
        return CodeTemplate(template).format(env)
```

### generate_reduction_code
```
generate_reduction_code(
    nOutputs: int,
    func: string,
    name: string,
    vt0: int,                          # 值类型参数（用于 reduction）
    f_inputs_type: string,
    reduction_accum_type: string,       # 累加器类型
    result_type: string,
    contiguous: bool,
    vectorized: bool,
    vec_size: int,
    max_threads_codegen: int
) -> string

用途: 生成 reduction kernel 的 CUDA 代码
算法:
    env = TemplateEnv()
    env.s("index_type", "unsigned int")
    env.s("scalar_type", f_inputs_type)
    env.s("result_type", result_type)
    env.s("reduction_accum_type", reduction_accum_type)
    env.s("vt0", vt0)
    env.s("name", name)
    env.s("max_threads_lb", max_threads_codegen)
    env.s("thread_work_size", JIT_THREAD_WORK_SIZE)
    
    # 类型支持字符串（同 generate_code）
    ...
    
    env.s("functor", func)
    env.s("output_vec_size", vec_size)
    
    template = jit_preamble + jit_common_types + offset_calc_template + get_reduction_template() + jit_epilogue
    return CodeTemplate(template).format(env)

备注:
    - reduction 不支持 dynamic_casting
    - 使用 reduction_template.cuh 中的模板
```

