--------------------------------
bitonicSwap
来源: aten/src/ATen/native/cuda/SortUtils.cuh
--------------------------------

【签名】
    @device
    bitonicSwap<Comparator, K, V>(
        kA: K, vA: V, validA: bool,
        kB: K, vB: V, validB: bool,
        dir: bool,
        comp: Comparator
    )

【算法】
    # 无效项总是排到末尾
    swap = (comp(kA, kB) and validA) or not validB
    
    if swap == dir:
        swapVars(kA, kB)
        swapVars(vA, vB)
        swapVars(validA, validB)

【并行模式】
    elementwise

【备注】
    - Bitonic排序的基本交换单元
    - validA/validB 用于处理填充的无效元素

--------------------------------
bitonicSort
来源: aten/src/ATen/native/cuda/SortUtils.cuh
--------------------------------

【签名】
    @device
    bitonicSort<Power2SortSize, IndexType, Comparator, K, V>(
        keys: K[Power2SortSize],
        values: V[Power2SortSize],
        valid: bool[Power2SortSize],
        comp: Comparator
    )

【算法】
    # Phase 1: 构建 bitonic 序列
    for size in [2, 4, 8, ..., Power2SortSize/2]:
        flag = (threadIdx.x & (size/2)) != 0
        
        for stride in [size/2, size/4, ..., 1]:
            __syncthreads()
            
            pos = 2 * threadIdx.x - (threadIdx.x & (stride - 1))
            bitonicSwap(
                keys[pos], values[pos], valid[pos],
                keys[pos + stride], values[pos + stride], valid[pos + stride],
                flag, comp
            )
    
    # Phase 2: 最终归并为有序序列
    for stride in [Power2SortSize/2, Power2SortSize/4, ..., 1]:
        __syncthreads()
        
        pos = 2 * threadIdx.x - (threadIdx.x & (stride - 1))
        bitonicSwap(
            keys[pos], values[pos], valid[pos],
            keys[pos + stride], values[pos + stride], valid[pos + stride],
            false, comp
        )
    
    __syncthreads()

【并行模式】
    - 每个线程处理 2 个元素（pos 和 pos+stride）
    - 使用 shared memory 存储 keys/values/valid
    - 多轮同步交换构建排序网络

【备注】
    - Power2SortSize 必须是 2 的幂次
    - 经典 Bitonic 排序网络实现
    - ROCm 平台禁用 #pragma unroll

--------------------------------
bitonicSortKVInPlace
来源: aten/src/ATen/native/cuda/SortUtils.cuh
--------------------------------

【签名】
    @device
    bitonicSortKVInPlace<KeyDims, ValueDims, block_dim_x, max_block_dim_y, K, V, Comparator, IndexType>(
        keys: TensorInfo<K, IndexType>,
        keySlices: IndexType,
        keySliceSize: IndexType,
        keySliceStride: IndexType,
        values: TensorInfo<V, IndexType>,
        valueSliceStride: IndexType,
        comp: Comparator
    )

【算法】
    items_per_thread = 2
    Power2SortSize = block_dim_x * 2
    
    # 定位要排序的 slice
    blockIndex = getLinearBlockId()
    linearIndex = blockIndex * blockDim.y + threadIdx.y
    
    if blockIndex * blockDim.y >= keySlices:
        return
    
    row_valid = linearIndex < keySlices
    
    # Shared memory 用于存储 max_block_dim_y 个并行排序
    __shared__ blockSharedKeys[max_block_dim_y][Power2SortSize]
    __shared__ blockSharedValues[max_block_dim_y][Power2SortSize]
    __shared__ blockSharedValid[max_block_dim_y][Power2SortSize]
    
    sharedKeys = blockSharedKeys[threadIdx.y]
    sharedValues = blockSharedValues[threadIdx.y]
    sharedValid = blockSharedValid[threadIdx.y]
    
    # 加载数据（每线程 2 个元素）
    keyStartOffset = IndexToOffset(linearIndex, keys)
    valueStartOffset = IndexToOffset(linearIndex, values)
    
    for k in range(items_per_thread):
        idx = threadIdx.x + k * blockDim.x
        valid = row_valid and idx < keySliceSize
        
        sharedKeys[idx] = keys.data[idx * keySliceStride + keyStartOffset] if valid else K{}
        sharedValues[idx] = values.data[idx * valueSliceStride + valueStartOffset] if valid else V{}
        sharedValid[idx] = valid
    
    # 排序
    bitonicSort<Power2SortSize, IndexType>(sharedKeys, sharedValues, sharedValid, comp)
    
    if not row_valid:
        return
    
    # 写回结果
    for k in range(items_per_thread):
        idx = threadIdx.x + k * blockDim.x
        if idx < keySliceSize:
            keys.data[idx * keySliceStride + keyStartOffset] = sharedKeys[idx]
            values.data[idx * valueSliceStride + valueStartOffset] = sharedValues[idx]

【并行模式】
    grid: 覆盖所有 slices
    block: (block_dim_x, block_dim_y)
    
    - gridDim: 保证覆盖 keySlices 个待排序的 slice
    - blockDim.y: 同一 block 内并行处理 max_block_dim_y 个 slice
    - blockDim.x: 单个 slice 的排序并行度（每线程 2 元素）

【备注】
    - 适用于小规模排序（Power2SortSize 通常 ≤ 2048）
    - 一次可排序 block_dim_x * 2 个元素
    - 使用 TensorInfo 支持任意维度和步长

--------------------------------
warpMergeSortKVInPlace
来源: aten/src/ATen/native/cuda/SortUtils.cuh
--------------------------------

【签名】
    @device
    warpMergeSortKVInPlace<KeyDims, ValueDims, sort_size, max_block_dim_y, K, V, Comparator, IndexType>(
        keys: TensorInfo<K, IndexType>,
        keySlices: IndexType,
        keySliceSize: IndexType,
        keySliceStride: IndexType,
        values: TensorInfo<V, IndexType>,
        valueSliceStride: IndexType,
        comp: Comparator,
        invalid_key: K
    )

【算法】
    # 定位要排序的 slice
    blockIndex = getLinearBlockId()
    linearIndex = blockIndex * blockDim.y + threadIdx.y
    
    if linearIndex >= keySlices:
        return
    
    keyStartOffset = IndexToOffset(linearIndex, keys)
    valueStartOffset = IndexToOffset(linearIndex, values)
    
    keys_slice = &keys.data[keyStartOffset]
    values_slice = &values.data[valueStartOffset]
    
    keys_iter = StridedRandomAccessor(keys_slice, keySliceStride)
    values_iter = StridedRandomAccessor(values_slice, valueSliceStride)
    
    items_per_thread = sort_size / C10_WARP_SIZE
    invalid_value = V{}
    
    # Shared memory 用于 CUB 操作的临时存储
    __shared__ union {
        LoadKeys::TempStorage load_keys
        LoadValues::TempStorage load_values
        Sort::TempStorage sort
        StoreKeys::TempStorage store_keys
        StoreValues::TempStorage store_values
    } tmp_storage[max_block_dim_y]
    
    warp_storage = tmp_storage[threadIdx.y]
    
    # 加载
    local_keys[items_per_thread]
    local_values[items_per_thread]
    
    cub::WarpLoad(warp_storage.load_keys).Load(keys_iter, local_keys, keySliceSize, invalid_key)
    WARP_SYNC()
    cub::WarpLoad(warp_storage.load_values).Load(values_iter, local_values, keySliceSize, invalid_value)
    WARP_SYNC()
    
    # 排序（使用 CUB 的 WarpMergeSort）
    cub::WarpMergeSort(warp_storage.sort).StableSort(
        local_keys, local_values, comp, keySliceSize, invalid_key
    )
    WARP_SYNC()
    
    # 写回
    cub::WarpStore(warp_storage.store_keys).Store(keys_iter, local_keys, keySliceSize)
    WARP_SYNC()
    cub::WarpStore(warp_storage.store_values).Store(values_iter, local_values, keySliceSize)

【并行模式】
    grid: 覆盖所有 slices
    block: (C10_WARP_SIZE, block_dim_y)
    
    - blockDim.x: 固定为 warp size (32)
    - blockDim.y: 同一 block 内并行处理多个 slice
    - 每个 warp 负责一个 slice 的排序

【备注】
    - 仅在 CUDA >= 11.6 时可用（HAS_WARP_MERGE_SORT()）
    - 使用 CUB 库的 WarpMergeSort，性能优于 Bitonic
    - sort_size 必须是 C10_WARP_SIZE 的倍数
    - StableSort 保证无效元素永远排在有效元素之后

--------------------------------
radixSortKVInPlace
来源: aten/src/ATen/native/cuda/SortUtils.cuh
--------------------------------

【签名】
    @device
    radixSortKVInPlace<KeyDims, ValueDims, block_size, items_per_thread, K, V, IndexType>(
        keys: TensorInfo<K, IndexType>,
        keySlices: IndexType,
        keySliceSize: IndexType,
        keySliceStride: IndexType,
        values: TensorInfo<V, IndexType>,
        valueSliceStride: IndexType,
        descending: bool
    )

【算法】
    # 定位要排序的 slice
    linearIndex = getLinearBlockId()
    
    if linearIndex >= keySlices:
        return
    
    keyStartOffset = IndexToOffset(linearIndex, keys)
    valueStartOffset = IndexToOffset(linearIndex, values)
    
    keys_slice = &keys.data[keyStartOffset]
    values_slice = &values.data[valueStartOffset]
    
    keys_iter = StridedRandomAccessor(keys_slice, keySliceStride)
    values_iter = StridedRandomAccessor(values_slice, valueSliceStride)
    
    # 构造无效键值（用于填充）
    invalid_key = if descending:
        cub::Traits<key_t>::LOWEST_KEY
    else:
        cub::Traits<key_t>::MAX_KEY
    invalid_value = V(0)
    
    # Shared memory 用于 CUB 操作的临时存储
    __shared__ union {
        LoadKeys::TempStorage load_keys
        LoadValues::TempStorage load_values
        Sort::TempStorage sort
        StoreKeys::TempStorage store_keys
        StoreValues::TempStorage store_values
    } tmp_storage
    
    # 加载
    local_keys[items_per_thread]
    local_values[items_per_thread]
    
    cub::BlockLoad(tmp_storage.load_keys).Load(keys_iter, local_keys, keySliceSize, invalid_key)
    __syncthreads()
    cub::BlockLoad(tmp_storage.load_values).Load(values_iter, local_values, keySliceSize, invalid_value)
    __syncthreads()
    
    # 排序（使用 CUB 的 BlockRadixSort）
    if descending:
        cub::BlockRadixSort(tmp_storage.sort).SortDescending(local_keys, local_values)
    else:
        cub::BlockRadixSort(tmp_storage.sort).Sort(local_keys, local_values)
    __syncthreads()
    
    # 写回
    cub::BlockStore(tmp_storage.store_keys).Store(keys_iter, local_keys, keySliceSize)
    __syncthreads()
    cub::BlockStore(tmp_storage.store_values).Store(values_iter, local_values, keySliceSize)

【并行模式】
    grid: 覆盖所有 slices
    block: block_size
    
    - 每个 block 处理一个 slice
    - 每个线程处理 items_per_thread 个元素
    - 一次可排序 block_size * items_per_thread 个元素

【备注】
    - 使用 CUB 库的 BlockRadixSort，适用于整数和浮点数
    - 通过 invalid_key 处理不足 block_size*items_per_thread 的情况
    - BlockRadixSort 比 BitonicSort 更高效，尤其是大规模排序
    - 支持升序和降序
