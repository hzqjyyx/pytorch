add_value_bounded
来源: aten/src/ATen/native/cuda/GridSampler.cuh:281
--------------------------------

【签名】
    @device
    add_value_bounded(
        data: scalar_t*,
        x: scalar_t, y: scalar_t,
        W: int, H: int,
        sW: int, sH: int,
        delta: scalar_t,
        padding_mode: GridSamplerPadding,
        align_corners: bool,
        NC_offset: index_t,
        memory_span: index_t
    )

【算法】
    x = compute_coordinates(x, W, padding_mode, align_corners)
    y = compute_coordinates(y, H, padding_mode, align_corners)
    
    ix = int(x)
    iy = int(y)
    
    safe_add_2d(data, iy, ix, sH, sW, H, W, delta, NC_offset, memory_span)

【并行模式】
    atomic_add

【备注】
    - 用于 backward 时累加梯度到对应像素

--------------------------------
get_cubic_coefficients_grad
来源: aten/src/ATen/native/cuda/GridSampler.cuh:301
--------------------------------

【签名】
    @device
    get_cubic_coefficients_grad(coeffs: scalar_t[4], t: scalar_t)

【算法】
    A = -0.75
    
    # d/dt of cubic interpolation coefficients
    x = -1 - t
    coeffs[0] = (-3 * A * x - 10 * A) * x - 8 * A
    
    x = -t
    coeffs[1] = (-3 * (A + 2) * x - 2 * (A + 3)) * x
    
    x = 1 - t
    coeffs[2] = (3 * (A + 2) * x - 2 * (A + 3)) * x
    
    x = 2 - t
    coeffs[3] = (3 * A * x - 10 * A) * x + 8 * A

【备注】
    - 计算 bicubic 插值系数的导数
    - 需与 UpSample.cuh:get_cubic_upsample_coefficients 一致
