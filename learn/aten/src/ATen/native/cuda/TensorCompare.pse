# TensorCompare.cpp

--------------------------------
isin_default_kernel_gpu:
来源: aten/src/ATen/native/cuda/TensorCompare.cpp
--------------------------------

【签名】
    isin_default_kernel_gpu(
        elements: Tensor[*D],
        test_elements: Tensor[N],
        invert: bool,
        out: Tensor[*D, bool]
    ) -> void

【算法】
    # 构造广播形状: elements的所有维度 + [-1]
    bc_shape = [1] * elements.dim + [-1]
    
    # 将 elements 扩展为 [..., 1]，test_elements 重塑为 [1, ..., 1, N]
    # 然后逐元素比较，沿最后一维归约
    if invert:
        out = (elements.unsqueeze(-1) != test_elements.view(bc_shape)).all(-1)
    else:
        out = (elements.unsqueeze(-1) == test_elements.view(bc_shape)).any(-1)

【备注】
    - 复合操作实现，生成 elements × test_elements 的笛卡尔积
    - 内存密集型，但在 CUDA 上速度快
    - invert=False: 检查是否在集合中 (any)
    - invert=True: 检查是否不在集合中 (all)

