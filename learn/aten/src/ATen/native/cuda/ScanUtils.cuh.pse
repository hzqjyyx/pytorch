tensor_kernel_scan_outer_dim
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @device
    tensor_kernel_scan_outer_dim(
        tgt_: Tensor[num_orows, row_size, num_irows, scalar_t],    # output
        src_: Tensor[num_orows, row_size, num_irows, scalar_t],
        num_orows: uint32,
        num_irows: uint32,
        row_size: uint32,
        init: scalar_t,
        binary_op: BinaryOp
    )

【算法】
    for orow in range(blockIdx.x, num_orows, gridDim.x):
        for irow in range(blockIdx.y * blockDim.x + threadIdx.x, num_irows, gridDim.y * blockDim.x):
            
            acc = init
            
            for col in range(row_size):
                acc = binary_op(acc, src_[orow, col, irow])
                tgt_[orow, col, irow] = acc

【并行模式】
    grid: (min(maxGridDim, num_orows), min(maxGridDim, ceil(num_irows / block_size)))
    block: (min(512, num_irows))
    
    - 每个线程处理一条 inner row
    - row_size 维度顺序扫描

--------------------------------
tensor_kernel_scan_innermost_dim_impl
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @device
    tensor_kernel_scan_innermost_dim_impl(
        row_buf: T*,                           # shared memory
        tgt_: Tensor[num_rows, row_size, T],   # output
        src_: Tensor[num_rows, row_size, T],
        num_rows: uint32,
        row_size: uint32,
        log_num_threads_x: uint32,
        init: T,
        binary_op: BinaryFunction
    )

【算法】
    num_threads_x = 1 << log_num_threads_x
    
    for block_row in range(blockIdx.x * blockDim.y, num_rows, blockDim.y * gridDim.x):
        row = block_row + threadIdx.y
        if row >= num_rows:
            continue
        
        block_total = init
        
        # 每次处理 2*num_threads_x 个元素
        for block_col in range(0, row_size, 2 * num_threads_x):
            col1 = block_col + threadIdx.x
            col2 = block_col + num_threads_x + threadIdx.x
            
            # Step 1: 加载到 shared memory
            if col1 < row_size:
                row_buf[threadIdx.x] = src_[row, col1]
            else:
                row_buf[threadIdx.x] = init
            
            if col2 < row_size:
                row_buf[num_threads_x + threadIdx.x] = src_[row, col2]
            else:
                row_buf[num_threads_x + threadIdx.x] = init
            
            # Step 2: 加上前面块的累积
            if threadIdx.x == 0:
                row_buf[0] = binary_op(row_buf[0], block_total)
            
            __syncthreads()
            
            # Step 3: Sklansky 并行前缀扫描
            for m in range(log_num_threads_x + 1):
                s = 1 << m
                a = ((threadIdx.x >> m) << (m + 1)) | s
                ti = a + (threadIdx.x % s)
                si = a - 1
                row_buf[ti] = binary_op(row_buf[ti], row_buf[si])
                __syncthreads()
            
            # Step 4: 写回输出
            if col1 < row_size:
                tgt_[row, col1] = row_buf[threadIdx.x]
            if col2 < row_size:
                tgt_[row, col2] = row_buf[num_threads_x + threadIdx.x]
            
            block_total = row_buf[2 * num_threads_x - 1]
            __syncthreads()

【并行模式】
    - 每个 threadIdx.y 处理一行
    - 每个 threadIdx.x 在 Sklansky 扫描中并行

--------------------------------
tensor_kernel_scan_innermost_dim
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @device
    tensor_kernel_scan_innermost_dim(
        tgt_: Tensor[num_rows, row_size, T],   # output
        src_: Tensor[num_rows, row_size, T],
        num_rows: uint32,
        row_size: uint32,
        log_num_threads_x: uint32,
        init: T,
        binary_op: BinaryFunction
    )

【算法】
    sbuf = shared_memory
    num_threads_x = 1 << log_num_threads_x
    row_buf = sbuf[num_threads_x * 2 * threadIdx.y : ...]
    
    if num_rows * row_size <= UINT_MAX:
        tensor_kernel_scan_innermost_dim_impl<T, uint32>(
            row_buf, tgt_, src_, num_rows, row_size, log_num_threads_x, init, binary_op
        )
    else:
        tensor_kernel_scan_innermost_dim_impl<T, size_t>(
            row_buf, tgt_, src_, num_rows, row_size, log_num_threads_x, init, binary_op
        )

【备注】
    - 根据总元素数选择索引类型 (uint32 vs size_t)

