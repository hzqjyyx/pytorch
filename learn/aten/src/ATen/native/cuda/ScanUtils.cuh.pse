--------------------------------
scan_outer_dim_with_indices
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @host→device
    scan_outer_dim_with_indices(
        self: Tensor[*outer, row_size, *inner, scalar_t],
        values: Tensor[*outer, row_size, *inner, scalar_t],     # output
        indices: Tensor[*outer, row_size, *inner, int64],       # output
        dim: int,
        init: scalar_t,
        binary_op: BinaryFunction
    )

【算法】
    row_size = self.size(dim)
    num_orows = prod(self.shape[:dim])
    num_irows = prod(self.shape[dim+1:])
    
    check_fits_in_unsigned(num_irows, "num_irows")
    check_fits_in_unsigned(num_orows, "num_orows")
    check_fits_in_unsigned(row_size, "row_size")
    
    threads = (min(512, num_irows))
    maxGridDim = getCurrentDeviceProperties()->maxGridSize[1]
    grid = (min(maxGridDim, num_orows), min(maxGridDim, ceil_div(num_irows, threads.x)))
    
    tensor_kernel_scan_outer_dim_with_indices<<<grid, threads>>>(
        self.data_ptr(), values.data_ptr(), indices.data_ptr(),
        num_orows, num_irows, row_size, init, binary_op
    )

【备注】
    - 将外层维度 (dim之前) 展平为 num_orows
    - 将内层维度 (dim之后) 展平为 num_irows

--------------------------------
scan_innermost_dim_with_indices
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @host→device
    scan_innermost_dim_with_indices(
        self: Tensor[*outer, row_size, scalar_t],
        values: Tensor[*outer, row_size, scalar_t],      # output
        indices: Tensor[*outer, row_size, int64],        # output
        init: scalar_t,
        binary_op: BinaryFunction
    )

【算法】
    row_size = self.size(-1)
    num_rows = self.numel() / row_size
    
    num_threads = 512
    log_num_threads_x = get_log_num_threads_x_inner_scan(num_rows, row_size)
    num_threads_x = 1 << log_num_threads_x
    num_threads_y = num_threads / num_threads_x
    
    threads = (num_threads_x, num_threads_y)
    grid = (min(maxGridSize[0], ceil_div(num_rows, threads.y)))
    
    mem_size = 2 * num_threads * (sizeof(scalar_t) + sizeof(int64))
    
    tensor_kernel_scan_innermost_dim_with_indices<<<grid, threads, mem_size>>>(
        self.data_ptr(), values.data_ptr(), indices.data_ptr(),
        num_rows, row_size, num_threads, log_num_threads_x, init, binary_op
    )

【备注】
    - 将外层维度展平为 num_rows

--------------------------------
scan_dim_with_indices
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    scan_dim_with_indices(
        self: Tensor[*D, scalar_t],
        values: Tensor[*D, scalar_t],      # output
        indices: Tensor[*D, int64],        # output
        dim: int64,
        init: scalar_t,
        binary_op: BinaryFunction
    )

【算法】
    self_ = self.expect_contiguous()
    assert values.is_contiguous() and indices.is_contiguous()
    
    if dim == self.dim() - 1:
        scan_innermost_dim_with_indices(*self_, values, indices, init, binary_op)
    else:
        scan_outer_dim_with_indices(*self_, values, indices, dim, init, binary_op)

【备注】
    - 根据 dim 位置选择不同的 kernel 实现

