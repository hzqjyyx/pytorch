--------------------------------
scan_innermost_dim
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    @host→device
    scan_innermost_dim(
        self: Tensor[*outer, row_size, scalar_t],
        result: Tensor[*outer, row_size, scalar_t],  # output
        init: scalar_t,
        binary_op: BinaryFunction
    )

【算法】
    row_size = self.size(-1)
    num_rows = self.numel() / row_size
    
    num_threads = 512
    log_num_threads_x = get_log_num_threads_x_inner_scan(num_rows, row_size)
    num_threads_x = 1 << log_num_threads_x
    num_threads_y = num_threads / num_threads_x
    
    threads = (num_threads_x, num_threads_y)
    maxGridDim = getCurrentDeviceProperties()->maxGridSize[0]
    grid = (min(maxGridDim, ceil_div(num_rows, threads.y)))
    
    check_fits_in_unsigned(num_rows, "Number of rows (self.numel()/self.size(self.dim()-1))")
    check_fits_in_unsigned(row_size, "row_size")
    
    tensor_kernel_scan_innermost_dim<<<grid, threads, num_threads * 2 * sizeof(scalar_t)>>>(
        result.data_ptr(), self.data_ptr(),
        num_rows, row_size, log_num_threads_x, init, binary_op
    )

--------------------------------
scan_dim
来源: aten/src/ATen/native/cuda/ScanUtils.cuh
--------------------------------

【签名】
    scan_dim(
        self: Tensor[*D, scalar_t],
        result: Tensor[*D, scalar_t],      # output
        dim: int64,
        init: scalar_t,
        binary_op: BinaryFunction
    )

【算法】
    self_ = self.expect_contiguous()
    assert result.is_contiguous()
    
    # 特殊情况: 扫描维度就是唯一维度
    if self.numel() == self.size(dim):
        if binary_op == std::plus and deterministicAlgorithms() and (self.is_floating_point() or self.is_complex()):
            # 确定性加法扫描
            if CUDA_VERSION > 11040 or USE_ROCM:
                cuda::cub::inclusive_deterministic_scan(self_.data_ptr(), result.data_ptr(), binary_op, self.numel())
            else:
                alert("cumsum_cuda_kernel not deterministic")
                cuda::cub::inclusive_scan(self_.data_ptr(), result.data_ptr(), binary_op, self.numel())
        else:
            cuda::cub::inclusive_scan(self_.data_ptr(), result.data_ptr(), binary_op, self.numel())
    
    elif dim == self.dim() - 1:
        scan_innermost_dim(*self_, result, init, binary_op)
    
    else:
        scan_outer_dim(*self_, result, dim, init, binary_op)

【备注】
    - 对于 1D cumsum，优先使用 CuB 库
    - 确定性算法: CUDA 11.4+ 或 ROCm 支持确定性扫描
    - 其他情况根据 dim 位置选择 kernel
