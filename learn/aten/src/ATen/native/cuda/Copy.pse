--------------------------------
copy_device_to_device
来源: aten/src/ATen/native/cuda/Copy.cu:213
--------------------------------

【签名】
    copy_device_to_device(
        iter: TensorIterator[dst=Tensor, src=Tensor],
        non_blocking: bool,
        p2p_enabled: bool
    )

【算法】
    numel = iter.numel()
    same_type = iter.dtype(0) == iter.dtype(1)
    same_conj = iter.tensor(0).is_conj() == iter.tensor(1).is_conj()
    same_neg = iter.tensor(0).is_neg() == iter.tensor(1).is_neg()
    memcpy_eligible = same_type and same_conj and same_neg and iter.is_contiguous()
    
    dst_device = iter.device(0)
    src_device = iter.device(1)
    
    CUDAGuard(src_device)
    copy_stream = getCurrentCUDAStream(src_device.index())
    
    # 跨设备拷贝：双向同步
    if src_device != dst_device:
        dst_ready = CUDAEvent()
        dst_ready.record(getCurrentCUDAStream(dst_device.index()))
        dst_ready.block(copy_stream)
    
    # 执行拷贝
    if memcpy_eligible:
        dst_ptr = iter.data_ptr(0)
        src_ptr = iter.data_ptr(1)
        size = numel * iter.element_size(0)
        
        if src_ptr != dst_ptr or src_device != dst_device:
            CUDACachingAllocator::memcpyAsync(
                dst_ptr, dst_device.index(),
                src_ptr, src_device.index(),
                size, copy_stream, p2p_enabled
            )
    else:
        # 类型转换路径
        if same_neg:
            if not same_conj:
                conj_kernel_cuda(iter)
            else:
                direct_copy_kernel_cuda(iter)
        else:
            if not same_conj:
                neg_conj_kernel_cuda(iter)
            else:
                neg_kernel_cuda(iter)
    
    # 跨设备拷贝：等待完成
    if src_device != dst_device:
        src_ready = CUDAEvent()
        src_ready.record(copy_stream)
        src_ready.block(getCurrentCUDAStream(dst_device.index()))

【备注】
    - 拷贝在源设备执行
    - 跨设备拷贝需双向同步（避免write-after-write/write-after-read冲突）
    - cudaMallocAsync内存跨非P2P设备需用cudaMemcpyPeerAsync

--------------------------------
copy_requires_temporaries
来源: aten/src/ATen/native/cuda/Copy.cu:297
--------------------------------

【签名】
    copy_requires_temporaries(iter: TensorIterator, p2p_enabled: bool) -> bool

【算法】
    dst_device = iter.device(0)
    src_device = iter.device(1)
    
    if dst_device == src_device:
        return false
    
    same_dtype = iter.dtype(0) == iter.dtype(1)
    if same_dtype and iter.is_contiguous():
        return false
    else if dst_device.is_cuda() and src_device.is_cuda():
        return not p2p_enabled
    else:
        return true

【备注】
    - 同设备拷贝不需要临时张量
    - 跨设备连续同类型拷贝可直接cudaMemcpyAsync
    - GPU间拷贝需P2P支持，否则需临时张量
    - CPU-GPU非连续/异类型拷贝需临时张量

