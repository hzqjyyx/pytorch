float8_copy_kernel_cuda
来源: aten/src/ATen/native/cuda/Copy.cu:45
--------------------------------

【签名】
    @host→device
    float8_copy_kernel_cuda(iter: TensorIterator[dst=float8_*, src=*])

【算法】
    dst_dtype = iter.dtype(0)
    src_dtype = iter.dtype(1)
    
    match (dst_dtype, src_dtype):
        (kFloat8_e4m3fn, kFloat):
            gpu_kernel_nocast(iter, λ(v: float) -> Float8_e4m3fn { Float8_e4m3fn(v) })
        (kFloat8_e4m3fn, kHalf):
            gpu_kernel_nocast(iter, λ(v: Half) -> Float8_e4m3fn { Float8_e4m3fn(v) })
        (kFloat8_e4m3fn, kBFloat16):
            gpu_kernel_nocast(iter, λ(v: BFloat16) -> Float8_e4m3fn { Float8_e4m3fn(v) })
        (kFloat8_e4m3fn, _):
            gpu_kernel(iter, λ(x: Float8_e4m3fn) -> Float8_e4m3fn { x })
            
        (kFloat8_e5m2, kFloat):
            gpu_kernel_nocast(iter, λ(v: float) -> Float8_e5m2 {
                ifdef AT_USE_NV_CVT_INTRINSICS:
                    x = __nv_cvt_float_to_fp8(v, __NV_NOSAT, __NV_E5M2)
                    return Float8_e5m2(x, from_bits())
                else:
                    return Float8_e5m2(v)
            })
        (kFloat8_e5m2, kHalf):
            gpu_kernel_nocast(iter, λ(v: Half) -> Float8_e5m2 {
                ifdef AT_USE_NV_CVT_INTRINSICS:
                    x = __nv_cvt_halfraw_to_fp8(v, __NV_NOSAT, __NV_E5M2)
                    return Float8_e5m2(x, from_bits())
                else:
                    return Float8_e5m2(v)
            })
        (kFloat8_e5m2, kBFloat16):
            gpu_kernel_nocast(iter, λ(v: BFloat16) -> Float8_e5m2 {
                ifdef AT_USE_NV_CVT_INTRINSICS:
                    x = __nv_cvt_bfloat16raw_to_fp8(v, __NV_NOSAT, __NV_E5M2)
                    return Float8_e5m2(x, from_bits())
                else:
                    return Float8_e5m2(v)
            })
        (kFloat8_e5m2, _):
            gpu_kernel(iter, λ(x: Float8_e5m2) -> Float8_e5m2 { x })
            
        (kFloat8_e4m3fnuz, kFloat):
            gpu_kernel_nocast(iter, λ(v: float) -> Float8_e4m3fnuz { Float8_e4m3fnuz(v) })
        (kFloat8_e4m3fnuz, kHalf):
            gpu_kernel_nocast(iter, λ(v: Half) -> Float8_e4m3fnuz { Float8_e4m3fnuz(v) })
        (kFloat8_e4m3fnuz, kBFloat16):
            gpu_kernel_nocast(iter, λ(v: BFloat16) -> Float8_e4m3fnuz { Float8_e4m3fnuz(v) })
        (kFloat8_e4m3fnuz, _):
            gpu_kernel(iter, λ(x: Float8_e4m3fnuz) -> Float8_e4m3fnuz { x })
            
        (kFloat8_e5m2fnuz, kFloat):
            gpu_kernel_nocast(iter, λ(v: float) -> Float8_e5m2fnuz { Float8_e5m2fnuz(v) })
        (kFloat8_e5m2fnuz, kHalf):
            gpu_kernel_nocast(iter, λ(v: Half) -> Float8_e5m2fnuz { Float8_e5m2fnuz(v) })
        (kFloat8_e5m2fnuz, kBFloat16):
            gpu_kernel_nocast(iter, λ(v: BFloat16) -> Float8_e5m2fnuz { Float8_e5m2fnuz(v) })
        (kFloat8_e5m2fnuz, _):
            gpu_kernel(iter, λ(x: Float8_e5m2fnuz) -> Float8_e5m2fnuz { x })
            
        (kFloat8_e8m0fnu, kFloat):
            gpu_kernel_nocast(iter, λ(v: float) -> Float8_e8m0fnu { Float8_e8m0fnu(v) })
        (kFloat8_e8m0fnu, kHalf):
            gpu_kernel_nocast(iter, λ(v: Half) -> Float8_e8m0fnu { Float8_e8m0fnu(v) })
        (kFloat8_e8m0fnu, kBFloat16):
            gpu_kernel_nocast(iter, λ(v: BFloat16) -> Float8_e8m0fnu { Float8_e8m0fnu(v) })
        (kFloat8_e8m0fnu, _):
            gpu_kernel(iter, λ(x: Float8_e8m0fnu) -> Float8_e8m0fnu { x })

【并行模式】
    elementwise

【备注】
    - AT_USE_NV_CVT_INTRINSICS: 使用NVIDIA硬件转换指令（cuda_fp8.h）
    - 非Float/Half/BFloat16源类型走同类型拷贝路径

--------------------------------
direct_copy_kernel_cuda
来源: aten/src/ATen/native/cuda/Copy.cu:176
--------------------------------

【签名】
    @host→device
    direct_copy_kernel_cuda(iter: TensorIterator[dst=dtype, src=*])

【算法】
    dst_dtype = iter.dtype(0)
    src_dtype = iter.dtype(1)
    
    if isQIntType(dst_dtype):
        AT_DISPATCH_QINT_TYPES(dst_dtype, {
            gpu_kernel(iter, λ(x: scalar_t) -> scalar_t { x })
        })
    else if isFloat8Type(dst_dtype):
        float8_copy_kernel_cuda(iter)
    else if src_dtype == kFloat and (dst_dtype == kBFloat16 or dst_dtype == kHalf):
        if dst_dtype == kBFloat16:
            bfloat16_copy_kernel_cuda(iter)
        else:
            float16_copy_kernel_cuda(iter)
    else if isBitsType(dst_dtype):
        assert dst_dtype == src_dtype
        AT_DISPATCH_BIT_TYPES(dst_dtype, {
            gpu_kernel_nocast(iter, λ(x: scalar_t) -> scalar_t { x })
        })
    else:
        AT_DISPATCH_V2(dst_dtype, {
            gpu_kernel(iter, λ(x: scalar_t) -> scalar_t { x })
        }, AT_ALL_TYPES_AND_COMPLEX, kHalf, kBool, kBFloat16, kComplexHalf, AT_BAREBONES_UNSIGNED_TYPES)

【并行模式】
    elementwise

【备注】
    - 量化类型(QInt)、浮点8类型、位类型有专门处理路径
    - float->half/bfloat16转换优化
    - bits类型禁止跨类型转换

