maybe_enable_p2p_access
来源: aten/src/ATen/native/cuda/Copy.cu:321
--------------------------------

【签名】
    maybe_enable_p2p_access(dst_device: Device, src_device: Device) -> bool

【算法】
    if dst_device.is_cpu() or src_device.is_cpu():
        return false
    return at::cuda::get_p2p_access(src_device.index(), dst_device.index())

--------------------------------
copy_kernel_cuda
来源: aten/src/ATen/native/cuda/Copy.cu:328
--------------------------------

【签名】
    copy_kernel_cuda(iter: TensorIterator[dst=Tensor, src=Tensor], non_blocking: bool)

【算法】
    dst_device = iter.device(0)
    src_device = iter.device(1)
    
    p2p_enabled = maybe_enable_p2p_access(dst_device, src_device)
    
    # 路径1: 需要临时张量
    if copy_requires_temporaries(iter, p2p_enabled):
        dst = iter.tensor(0)
        conversion_device = kCUDA if non_blocking else kCPU
        
        if iter.device_type(1) == conversion_device:
            # GPU转换
            dst_contig = dst if dst.is_contiguous() else empty_like(dst)
            src_contig = iter.tensor(1).to(iter.dtype(0)).expand_as(dst).contiguous()
        else:
            # CPU转换
            same_type = iter.dtype(0) == iter.dtype(1)
            dst_contig = dst if (dst.is_contiguous() and same_type) else empty_like(dst, iter.dtype(1))
            src_contig = iter.tensor(1).expand_as(dst).contiguous()
        
        # 传播conj/neg标志
        dst_contig._set_conj(dst.is_conj())
        src_contig._set_conj(iter.tensor(1).is_conj())
        dst_contig._set_neg(dst.is_neg())
        src_contig._set_neg(iter.tensor(1).is_neg())
        
        dst_contig.copy_(src_contig, non_blocking)
        
        if not dst_contig.is_same(dst):
            dst.copy_(dst_contig, non_blocking)
        return
    
    # 路径2: GPU到GPU
    if dst_device.is_cuda() and src_device.is_cuda():
        copy_device_to_device(iter, non_blocking, p2p_enabled)
        return
    
    # 路径3: CPU-GPU
    CUDAGuard device_guard
    if dst_device.is_cuda() and src_device.is_cpu():
        device_guard.set_device(dst_device)
        kind = cudaMemcpyHostToDevice
    else if dst_device.is_cpu() and src_device.is_cuda():
        device_guard.set_device(src_device)
        kind = cudaMemcpyDeviceToHost
    
    dst_ptr = iter.data_ptr(0)
    src_ptr = iter.data_ptr(1)
    nbytes = iter.numel() * iter.element_size(0)
    stream = getCurrentCUDAStream()
    
    if non_blocking:
        cudaMemcpyAsync(dst_ptr, src_ptr, nbytes, kind, stream)
        
        # 记录pinned memory事件（用于缓存host allocator）
        host_tensor = iter.tensor(0) if dst_device == kCPU else iter.tensor(1)
        ptr = dst_ptr if dst_device == kCPU else src_ptr
        ctx = host_tensor.storage().data_ptr().get_context()
        CachingHostAllocator_recordEvent(ptr, ctx, stream)
    else:
        at::cuda::memcpy_and_sync(dst_ptr, src_ptr, nbytes, kind, stream)
    
    # 处理conj/neg差异
    if iter.tensor(0).is_conj() != iter.tensor(1).is_conj():
        iter.tensor(0).conj_physical_()
    if iter.tensor(0).is_neg() != iter.tensor(1).is_neg():
        iter.tensor(0).neg_()

【备注】
    - 三条路径：临时张量路径、GPU-GPU、CPU-GPU
    - non_blocking=true: GPU转换，异步拷贝
    - non_blocking=false: CPU转换，同步拷贝
    - CPU-GPU异步拷贝需记录pinned memory事件
    - conj/neg标志可能需物理转换

