--------------------------------

【签名】
    grid_sampler_2d_cuda(
        input: Tensor[N, C, H_in, W_in],
        grid: Tensor[N, H_out, W_out, 2],
        interpolation_mode: int64,
        padding_mode: int64,
        align_corners: bool
    ) -> Tensor[N, C, H_out, W_out]

【算法】
    output = at::empty(N, C, H_out, W_out, dtype=input.dtype)
    launch_grid_sampler_2d_forward_kernel(
        output, input, grid, interpolation_mode, padding_mode, align_corners
    )
    return output

