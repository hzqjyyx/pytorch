grid_sampler_2d_backward_cuda:
来源: aten/src/ATen/native/cuda/GridSampler.cpp
--------------------------------

【签名】
    grid_sampler_2d_backward_cuda(
        grad_output: Tensor[N, C, H_out, W_out],
        input: Tensor[N, C, H_in, W_in],
        grid: Tensor[N, H_out, W_out, 2],
        interpolation_mode: int64,
        padding_mode: int64,
        align_corners: bool,
        output_mask: array<bool, 2>
    ) -> (Tensor[N, C, H_in, W_in], Tensor[N, H_out, W_out, 2])

【算法】
    # 根据 output_mask[0] 决定是否计算 grad_input
    if output_mask[0]:
        grad_input = at::zeros_like(input)
    else:
        grad_input = Tensor()
    
    grad_grid = at::empty_like(grid)
    
    launch_grid_sampler_2d_backward_kernel(
        grad_input, grad_grid, grad_output, input, grid,
        interpolation_mode, padding_mode, align_corners, output_mask
    )
    
    return (grad_input, grad_grid)

