    )

【算法】
    check_grid_sampler_common(input, grid)
    check_grid_sampler_3d(input, grid, interpolation_mode)
    
    count = N * D_out * H_out * W_out
    if count > 0:
        AT_DISPATCH_FLOATING_TYPES_AND2(Half, BFloat16, input.dtype):
            if canUse32BitIndexMath(input, grid, output):
                grid_sampler_3d_kernel<scalar_t, int32>
                    <<<GET_BLOCKS(count, 512), 512, stream>>>(
                        count, getTensorInfo<int32>(input),
                        getTensorInfo<int32>(grid),
                        getTensorInfo<int32>(output),
                        interpolation_mode, padding_mode, align_corners
                    )
            else:
                grid_sampler_3d_kernel<scalar_t, int64>
                    <<<GET_BLOCKS(count, 512), 512, stream>>>(
                        count, getTensorInfo<int64>(input),
                        getTensorInfo<int64>(grid),
                        getTensorInfo<int64>(output),
                        interpolation_mode, padding_mode, align_corners
                    )

【备注】
    - 块大小为 512（2D 版本为 256）

--------------------------------
launch_grid_sampler_2d_backward_kernel:
来源: aten/src/ATen/native/cuda/GridSampler.cu
--------------------------------

【签名】
    @host→device
    launch_grid_sampler_2d_backward_kernel(
        grad_input: TensorBase[N, C, H_in, W_in],
        grad_grid: TensorBase[N, H_out, W_out, 2],
        grad_output: TensorBase[N, C, H_out, W_out],
        input: TensorBase[N, C, H_in, W_in],
        grid: TensorBase[N, H_out, W_out, 2],
        interpolation_mode: int64,
        padding_mode: int64,
        align_corners: bool,
        output_mask: array<bool, 2>
    )

【算法】
    check_grid_sampler_common(input, grid)
    check_grid_sampler_2d(input, grid)
    
    globalContext().alertNotDeterministic("grid_sampler_2d_backward_cuda")
    
    input_requires_grad = output_mask[0]
    count = N * H_out * W_out
    
    if count > 0:
        AT_DISPATCH_FLOATING_TYPES_AND2(Half, BFloat16, input.dtype):
            if canUse32BitIndexMath(input, grid, grad_output):
                grid_sampler_2d_backward_kernel<scalar_t, int32>
                    <<<GET_BLOCKS(count, 256), 256, stream>>>(
                        count, getTensorInfo<int32>(grad_output),
                        getTensorInfo<int32>(input),
                        getTensorInfo<int32>(grid),
                        input_requires_grad ? getTensorInfo<int32>(grad_input) : empty,
                        getTensorInfo<int32>(grad_grid),
                        interpolation_mode, padding_mode, align_corners,
                        input_requires_grad ? grad_input.numel() : 0,
                        input_requires_grad
                    )
            else:
                # 64 位索引版本

【备注】
    - 因使用 atomicAdd，此操作非确定性
    - 若不需要 grad_input，传递空 TensorInfo 以避免内存分配

