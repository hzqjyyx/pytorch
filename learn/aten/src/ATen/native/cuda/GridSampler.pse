【签名】
    @host→device
    launch_grid_sampler_3d_forward_kernel(
        output: TensorBase[N, C, D_out, H_out, W_out],
        input: TensorBase[N, C, D_in, H_in, W_in],
        grid: TensorBase[N, D_out, H_out, W_out, 3],
