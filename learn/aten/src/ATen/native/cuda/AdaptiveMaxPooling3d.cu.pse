【签名】
    @host→device
    adaptivemaxgradinput_loop<scalar_t>(
        gradInput_data: scalar_t*,
        gradOutput_data: scalar_t*,
        indices_data: int64*,
        totalZ: int64,
        isizeT, isizeH, isizeW: int,
        osizeT, osizeH, osizeW: int
    )

【算法】
    offsetZ = 0
    threads = (32, 8)
    blocksH = max(16 / totalZ, 1)

    while totalZ > 0:
        blocks = (min(totalZ, 65535), blocksH)
        adaptivemaxgradinput<<<blocks, threads>>>(
            gradInput_data, gradOutput_data, indices_data,
            isizeT, isizeH, isizeW, osizeT, osizeH, osizeW, offsetZ
        )
        totalZ -= 65535
        offsetZ += 65535

