atomicadaptivemaxgradinput_loop:
来源: aten/src/ATen/native/cuda/AdaptiveMaxPooling3d.cu
--------------------------------

【签名】
    @host→device
    atomicadaptivemaxgradinput_loop<scalar_t>(
        gradInput_data: scalar_t*,
        gradOutput_data: scalar_t*,
        indices_data: int64*,
        totalZ: int64,
        isizeT, isizeH, isizeW: int,
        osizeT, osizeH, osizeW: int
    )

【算法】
    offsetZ = 0
    threads = (32, 8)
    blocksH = max(16 / totalZ, 1)

    while totalZ > 0:
        blocks = (min(totalZ, 65535), blocksH)
        atomicadaptivemaxgradinput<<<blocks, threads>>>(
            gradInput_data, gradOutput_data, indices_data,
            isizeT, isizeH, isizeW, osizeT, osizeH, osizeW, offsetZ
        )
        totalZ -= 65535
        offsetZ += 65535

--------------------------------
adaptive_max_pool3d_out_cuda:
来源: aten/src/ATen/native/cuda/AdaptiveMaxPooling3d.cu
--------------------------------

【签名】
    @host→device
    adaptive_max_pool3d_out_cuda(
        input: Tensor[B?, D, T, H, W],      # 4D或5D
        output_size: [osizeT, osizeH, osizeW],
        output: Tensor[B?, D, osizeT, osizeH, osizeW],
        indices: Tensor[B?, D, osizeT, osizeH, osizeW, int64]
    )

【算法】
    if input.numel == 0 or output.numel == 0:
        return

    input_ = input.contiguous() if input.ndim == 5 else input

    if input_.ndim == 4:
        sizeD = input_.size(0)
        isizeT, isizeH, isizeW = input_.shape[1:4]
        istrideD, istrideT, istrideH, istrideW = input_.stride()
        totalZ = sizeD * osizeT
    else:
        sizeB, sizeD = input_.shape[0:2]
        isizeT, isizeH, isizeW = input_.shape[2:5]
        
        # 展平 batch 和 channel 维度
        istrideD = isizeT * isizeH * isizeW
        istrideT, istrideH, istrideW = input_.stride()[2:5]
        totalZ = sizeB * sizeD * osizeT

    AT_DISPATCH_FLOATING_TYPES_AND2(kHalf, kBFloat16, input_.scalar_type(), [&] {
        adaptivemaxpool_loop(
            input_.const_data_ptr<scalar_t>(),
            output.mutable_data_ptr<scalar_t>(),
            indices.mutable_data_ptr<int64_t>(),
            totalZ, isizeT, isizeH, isizeW,
            osizeT, osizeH, osizeW,
            istrideD, istrideT, istrideH, istrideW
        )
    })

【备注】
    - 支持 float, double, half, bfloat16
    - 4D输入: [D, T, H, W]
    - 5D输入: [B, D, T, H, W]

--------------------------------
adaptive_max_pool3d_backward_out_cuda:
来源: aten/src/ATen/native/cuda/AdaptiveMaxPooling3d.cu
--------------------------------

【签名】
    @host→device
    adaptive_max_pool3d_backward_out_cuda(
        gradOutput: Tensor[B?, D, osizeT, osizeH, osizeW],
        input: Tensor[B?, D, T, H, W],
        indices: Tensor[B?, D, osizeT, osizeH, osizeW, int64],
        gradInput: Tensor[B?, D, T, H, W]
    )

【算法】
    if gradOutput.numel == 0:
        return

    gradOutput_ = gradOutput.contiguous()
    gradInput.zero_()

    if input.ndim == 4:
        sizeD = input.size(0)
        isizeT, isizeH, isizeW = input.shape[1:4]
        osizeT, osizeH, osizeW = gradOutput_.shape[1:4]
        totalZ = sizeD * osizeT
    else:
        sizeB, sizeD = input.shape[0:2]
        isizeT, isizeH, isizeW = input.shape[2:5]
        osizeT, osizeH, osizeW = gradOutput_.shape[2:5]
        totalZ = sizeB * sizeD * osizeT

    # 判断是否需要原子操作
    atomic = (isizeW % osizeW != 0) or (isizeH % osizeH != 0) or (isizeT % osizeT != 0)

    if atomic:
        AT_DISPATCH_FLOATING_TYPES_AND2(kHalf, kBFloat16, input.scalar_type(), [&] {
            atomicadaptivemaxgradinput_loop(
                gradInput.mutable_data_ptr<scalar_t>(),
                gradOutput_.const_data_ptr<scalar_t>(),
                indices.const_data_ptr<int64_t>(),
                totalZ, isizeT, isizeH, isizeW,
                osizeT, osizeH, osizeW
            )
        })
    else:
        AT_DISPATCH_FLOATING_TYPES_AND2(kHalf, kBFloat16, input.scalar_type(), [&] {
            adaptivemaxgradinput_loop(
                gradInput.mutable_data_ptr<scalar_t>(),
                gradOutput_.const_data_ptr<scalar_t>(),
                indices.const_data_ptr<int64_t>(),
                totalZ, isizeT, isizeH, isizeW,
                osizeT, osizeH, osizeW
            )
        })

【备注】
    - 根据输入输出尺寸是否整除选择原子/非原子版本
    - gradInput 先清零，再累加梯度
