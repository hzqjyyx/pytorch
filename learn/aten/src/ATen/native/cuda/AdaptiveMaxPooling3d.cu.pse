atomicadaptivemaxgradinput:
来源: aten/src/ATen/native/cuda/AdaptiveMaxPooling3d.cu
--------------------------------

【签名】
    @device
    atomicadaptivemaxgradinput<T>(
        gradInput: T*,
        gradOutput: T*,
        indices: int64*,
        isizeT, isizeH, isizeW: int,
        osizeT, osizeH, osizeW: int,
        offsetZ: int64
    )

【算法】
    o_plane = blockIdx.x + offsetZ
    d = o_plane / osizeT

    gradInput_d = gradInput + d*isizeT*isizeH*isizeW
    gradOutput_dt = gradOutput + o_plane*osizeH*osizeW
    indices_dt = indices + o_plane*osizeH*osizeW

    parallel_for oh in range(osizeH):
        parallel_for ow in range(osizeW):
            grad_delta = gradOutput_dt[oh*osizeW + ow]
            argmax = indices_dt[oh*osizeW + ow]
            gpuAtomicAddNoReturn(&gradInput_d[argmax], grad_delta)

【并行模式】
    atomic_add

【备注】
    - 原子版本，用于输入输出尺寸不整除的情况
    - 同一输入位置可能被多个输出引用

