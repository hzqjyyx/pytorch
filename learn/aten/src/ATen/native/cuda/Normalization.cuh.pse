        momentum: StatT,
        running_mean: Optional[Tensor[C]],
        running_var: Optional[Tensor[C]],
        save_mean: Tensor[C],
        save_invstd: Tensor[C]
    )

【算法】
    batch_norm_update_stats_channels_last_template(
        input, save_mean, save_invstd,
        running_mean, running_var, momentum, eps
    )

【并行模式】
    同 batch_norm_update_stats_channels_last_template

