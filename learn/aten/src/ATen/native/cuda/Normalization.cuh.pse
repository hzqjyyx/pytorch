batch_norm_backward_reduce_channels_last
来源: aten/src/ATen/native/cuda/Normalization.cuh
--------------------------------

【签名】
    @host→device
    batch_norm_backward_reduce_channels_last<InT, StatT>(
        grad_output: Tensor[N, H, W, C],
        input: Tensor[N, H, W, C],
        mean: Tensor[C],
        invstd: Tensor[C],
        weight: Optional[Tensor[C]],
        input_g: bool,
        weight_g: bool,
        bias_g: bool,
        save_mean: Tensor[C],
        save_invstd: Tensor[C],
        running_mean: Tensor[C],
        running_var: Tensor[C],
        sum_dy: Tensor[C],
        sum_dy_xmu: Tensor[C],
        grad_weight: Tensor[C],
        grad_bias: Tensor[C]
    )

【算法】
    tf32_flag = at::globalContext().allowTF32CuBLAS()
    at::globalContext().setAllowTF32CuBLAS(false)

    stream = at::cuda::getCurrentCUDAStream()
    block = (512,)
    grid = (C,)

    grad_weight_ptr = grad_weight if weight_g else None
    grad_bias_ptr = grad_bias if bias_g else None

    batch_norm_backward_reduce_channels_last_kernel<<<grid, block, 0, stream>>>(
        grad_output, input, mean, invstd,
        sum_dy, sum_dy_xmu, grad_weight_ptr, grad_bias_ptr
    )

    at::globalContext().setAllowTF32CuBLAS(tf32_flag)

【备注】
    - 禁用TF32以保证数值精度

