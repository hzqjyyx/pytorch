batch_norm_stats_channels_last
来源: aten/src/ATen/native/cuda/Normalization.cuh
--------------------------------

【签名】
    @host→device
    batch_norm_stats_channels_last<InT, StatT>(
        input: Tensor[N, H, W, C],
        eps: StatT,
        momentum: StatT,
        running_mean: Optional[Tensor[C]],
        running_var: Optional[Tensor[C]],
        save_mean: Tensor[C],
        save_invstd: Tensor[C]
    )

【算法】
    tf32_flag = at::globalContext().allowTF32CuBLAS()
    at::globalContext().setAllowTF32CuBLAS(false)

    stream = at::cuda::getCurrentCUDAStream()
    block = (512,)
    grid = (C,)

    batch_norm_collect_statistics_channels_last_kernel<<<grid, block, 0, stream>>>(
        input, eps, momentum, running_mean, running_var, save_mean, save_invstd
    )

    at::globalContext().setAllowTF32CuBLAS(tf32_flag)

【备注】
    - 禁用TF32以保证数值精度

