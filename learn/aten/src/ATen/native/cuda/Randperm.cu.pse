--------------------------------
randperm_out_cuda
来源: aten/src/ATen/native/cuda/Randperm.cu
--------------------------------

【签名】
    @host→device
    randperm_out_cuda(n: int64, generator: Optional[Generator], result: Tensor[n]) -> Tensor[n]

    约束:
    - n >= 0
    - result.dtype 精度需支持表示 n 的所有整数

【算法】
    # Step 0: 边界检查
    check_supported_max_int_with_precision(n, result)
    result.resize_([n])
    
    if n == 0:
        return result
    
    # Step 1: 生成 0 到 n-1 的顺序序列
    range = at::arange(n, result.options())
    
    # Step 2: 准备输出缓冲区
    if result.is_contiguous():
        shuffled_data = result.data_ptr()
    else:
        shuffled = at::empty(n, result.options())
        shuffled_data = shuffled.data_ptr()
    
    # Step 3: 计算随机键位数 (见算法说明)
    # 保证重复键概率 < 10% 的最小位数
    log_threshold_12 = log(0.9) * 12
    bits = min(64, ceil(log2(n - (6 * n² + 1) / log_threshold_12)))
    
    # Step 4: 生成随机键并排序
    if bits <= 32:
        # 使用 32 位键
        keys = at::empty([n], dtype=int32).random_(INT_MIN, INT_MAX, generator)
        keys_tmp = at::empty_like(keys)
        
        at::cuda::cub::radix_sort_pairs(
            keys, keys_tmp.data_ptr(),
            range.data_ptr(), shuffled_data,
            n, ascending=false, begin_bit=0, end_bit=bits
        )
        
        randperm_handle_duplicate_keys(keys_tmp.data_ptr(), shuffled_data, bits, n, generator)
    else:
        # 使用 64 位键
        keys = at::empty([n], dtype=int64).random_(INT64_MIN, INT64_MAX, generator)
        keys_tmp = at::empty_like(keys)
        
        at::cuda::cub::radix_sort_pairs(
            keys, keys_tmp.data_ptr(),
            range.data_ptr(), shuffled_data,
            n, ascending=false, begin_bit=0, end_bit=bits
        )
        
        randperm_handle_duplicate_keys(keys_tmp.data_ptr(), shuffled_data, bits, n, generator)
    
    # Step 5: 拷贝回非连续输出
    if not result.is_contiguous():
        result.copy_(shuffled)
    
    return result

【备注】
    - 算法原理: 通过对随机键排序生成随机排列
      1. 生成 n 个独立随机键
      2. 按键对 [0, n-1] 排序
      3. 处理重复键导致的岛屿 (islands)
    
    - 重复键问题:
      * 独立随机生成的键可能重复
      * 稳定排序会使 (0,1) 比 (1,0) 出现更频繁
      * 解决方案: 控制键位数使重复概率 < 10%，然后用 randperm_handle_duplicate_keys 额外打散岛屿
    
    - randperm_handle_duplicate_keys (见 Randperm.cuh):
      * 每个线程检测自己是否在岛屿中 (键与邻居相同)
      * 岛屿首线程 (island leader) 统计岛屿大小
      * 首线程用 Fisher-Yates 串行打散岛屿内的值
    
    - OpaqueType<sizeof(scalar_t)>: 避免为相同大小的不同类型生成重复 kernel
