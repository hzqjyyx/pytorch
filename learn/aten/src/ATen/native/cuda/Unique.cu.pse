    }, AT_ALL_TYPES, kBool, kBFloat16, kHalf, AT_BAREBONES_UNSIGNED_TYPES)

【备注】
    - sorted 参数被忽略，CUDA实现总是排序
    - 调用 internal::unique_cuda_template（定义在 UniqueCub.cuh）


--------------------------------
unique_dim_cuda
来源: aten/src/ATen/native/cuda/Unique.cu
--------------------------------

【签名】
    unique_dim_cuda(
        self: Tensor,
        dim: int64,
        sorted: bool,
        return_inverse: bool,
        return_counts: bool
    ) -> (output: Tensor, inverse: Tensor, counts: Tensor)

【算法】
    AT_DISPATCH_V2(self.scalar_type(), "unique_dim", [&] {
        return unique_dim_cuda_template<scalar_t>(self, dim, false, return_inverse, return_counts)
    }, AT_ALL_TYPES, kBool, kBFloat16, kHalf, AT_BAREBONES_UNSIGNED_TYPES)

【备注】
    - consecutive=false，进行全局去重（含排序）


--------------------------------
unique_dim_consecutive_cuda
来源: aten/src/ATen/native/cuda/Unique.cu
--------------------------------

【签名】
    unique_dim_consecutive_cuda(
        self: Tensor,
        dim: int64,
        return_inverse: bool,
        return_counts: bool
    ) -> (output: Tensor, inverse: Tensor, counts: Tensor)

【算法】
    AT_DISPATCH_V2(self.scalar_type(), "unique_dim", [&] {
        return unique_dim_cuda_template<scalar_t>(self, dim, true, return_inverse, return_counts)
    }, AT_ALL_TYPES, kBool, kBFloat16, kHalf, AT_BAREBONES_UNSIGNED_TYPES)

【备注】
    - consecutive=true，仅对连续重复去重（无排序）


--------------------------------
unique_consecutive_cuda
来源: aten/src/ATen/native/cuda/Unique.cu
--------------------------------

【签名】
    unique_consecutive_cuda(
        self: Tensor,
        return_inverse: bool,
        return_counts: bool,
        dim: Optional[int64]
    ) -> (output: Tensor, inverse: Tensor, counts: Tensor)

【算法】
    if not dim.has_value():
        # 无维度参数：展平后处理
        AT_DISPATCH_V2(self.scalar_type(), "unique", [&] {
            return internal::unique_cuda_template<scalar_t>(self, true, return_inverse, return_counts)
        }, AT_ALL_TYPES, kBool, kBFloat16, kHalf, AT_BAREBONES_UNSIGNED_TYPES)
    else:
        # 有维度参数：调用 unique_dim_consecutive
        return unique_dim_consecutive_cuda(self, dim.value(), return_inverse, return_counts)

【备注】
    - dim 为空时处理展平tensor
    - dim 有值时调用 unique_dim_consecutive_cuda
