foreach_tensor_div_tensor_kernel_cuda (非原地)
来源: aten/src/ATen/native/cuda/ForeachBinaryOpScalarTensor.cu:200-204
--------------------------------

【签名】
    foreach_tensor_div_tensor_kernel_cuda(
        tensors: TensorList,
        scalar: Tensor
    ) -> List[Tensor]

【算法】
    # 标量tensor在CPU时退化到scalar版本
    if scalar.device().type() == DeviceType::CPU:
        return foreach_tensor_div_scalar_kernel_cuda(tensors, scalar.item())

    check_foreach_api_restrictions(tensors)

    # 快速路径检查 (除法操作)
    if not (can_use_fast_route(tensors, div_op=true) and 
            tensors[0].scalar_type() == scalar.scalar_type()):
        return foreach_tensor_div_tensor_kernel_slow(tensors, scalar)

    return all_types_complex_bool_half_bfloat16<std::divides>(tensors, scalar)

