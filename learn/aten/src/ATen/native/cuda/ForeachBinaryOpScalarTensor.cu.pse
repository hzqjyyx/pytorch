--------------------------------

【签名】
    foreach_tensor_mul_tensor_kernel_cuda_(
        tensors: TensorList,
        scalar: Tensor
    )

【算法】
    # 标量tensor在CPU时退化到scalar版本
    if scalar.device().type() == DeviceType::CPU:
        foreach_tensor_mul_scalar_kernel_cuda_(tensors, scalar.item())
        return

    check_foreach_api_restrictions(tensors)

    # 快速路径检查 (非除法操作)
    if not (can_use_fast_route(tensors, div_op=false) and 
            tensors[0].scalar_type() == scalar.scalar_type()):
        foreach_tensor_mul_tensor_kernel_slow_(tensors, scalar)
        return

    all_types_complex_bool_half_bfloat16_<std::multiplies>(tensors, scalar)

