--------------------------------
make_input_offset_calculator
来源: aten/src/ATen/native/cuda/Loops.cuh
--------------------------------

【签名】
    make_input_offset_calculator<N>(iter: TensorIteratorBase) -> OffsetCalculator<N>

【算法】
    # 提取所有输入tensor的strides和element_sizes
    for i in range(N):
        strides[i] = iter.strides(i + iter.noutputs())
        element_sizes[i] = iter.element_size(i + iter.noutputs())
    
    return OffsetCalculator<N>(iter.ndim(), iter.shape(), strides, element_sizes)

【备注】
    - N = iter.ntensors() - iter.noutputs()
    - 用于计算输入tensor的内存偏移

--------------------------------
make_output_offset_calculator
来源: aten/src/ATen/native/cuda/Loops.cuh
--------------------------------

【签名】
    make_output_offset_calculator<num_outputs>(iter: TensorIteratorBase) -> OffsetCalculator<num_outputs>

【算法】
    # 提取所有输出tensor的strides和element_sizes
    for i in range(num_outputs):
        strides[i] = iter.strides(i)
        element_sizes[i] = iter.element_size(i)
    
    return OffsetCalculator<num_outputs>(iter.ndim(), iter.shape(), strides, element_sizes)

【备注】
    - num_outputs = iter.noutputs()
    - 用于计算输出tensor的内存偏移

--------------------------------
elementwise_kernel_helper
来源: aten/src/ATen/native/cuda/Loops.cuh
--------------------------------

【签名】
    @device
    elementwise_kernel_helper<func_t, policy_t>(f: func_t, policy: policy_t)

【算法】
    constexpr elems_per_thread = policy_t::tws
    idx = blockIdx.x
    
    # Step 1: 加载
    args = policy.load(idx)  # args: array[elems_per_thread] of tuple
    
    # Step 2: 计算
    for i in range(elems_per_thread):
        if policy.check_inbounds(i):
            results[i] = f(*args[i])
    
    # Step 3: 存储
    policy.store(results, idx)

【并行模式】
    - blockIdx.x: 处理不同的work chunk
    - 每个block处理 elems_per_thread 个元素
    - policy控制加载/存储和边界检查

【备注】
    - policy_t定义了具体的内存访问模式（见MemoryAccess.cuh）
    - 这是一个通用的elementwise kernel helper

--------------------------------
gpu_kernel_nocast
来源: aten/src/ATen/native/cuda/Loops.cuh
--------------------------------

【签名】
    @host→device
    gpu_kernel_nocast<func_t>(iter: TensorIteratorBase, f: func_t)

【算法】
    # Step 1: 验证所有tensor都在CUDA设备上
    for arg in range(iter.ntensors()):
        assert iter.device(arg).is_cuda()
    
    # Step 2: 空tensor直接返回
    if iter.numel() == 0:
        return
    
    # Step 3: 处理大索引情况（>2^31）
    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            gpu_kernel_nocast(sub_iter, f)
        return
    
    # Step 4: 调用实际kernel
    gpu_kernel_impl_nocast(iter, f)

【备注】
    - 不进行类型转换的版本
    - 自动分割大tensor以支持32位索引

