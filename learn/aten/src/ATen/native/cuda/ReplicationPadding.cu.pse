replication_pad3d_backward_out_cuda_template
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @host→device
    replication_pad3d_backward_out_cuda_template(
        gradInput: Tensor[?, C, D_in, H_in, W_in],
        gradOutput: Tensor[?, C, D_out, H_out, W_out],
        input: Tensor[?, C, D_in, H_in, W_in],
        paddingSize: [pleft, pright, ptop, pbottom, pfront, pback]
    )

【算法】
    assert paddingSize.size == 6
    pleft, pright, ptop, pbottom, pfront, pback = paddingSize
    
    shapeAndGradOutputCheck3d(input, gradOutput, pleft, pright, ptop, pbottom, pfront, pback)

    gradInput.resize_as_(input)
    if gradInput.numel == 0:
        return

    gradInput.zero_()

    # 添加batch维度(如果是4D输入)
    if input.dim == 4:
        gradInput_ = gradInput.unsqueeze(0)
        gradOutput_ = gradOutput.unsqueeze(0)
    else:
        gradInput_ = gradInput
        gradOutput_ = gradOutput

    B = gradOutput_.size(0)
    C = gradOutput_.size(1)

    # 分块处理以避免超过CUDA grid限制
    for block_y in range(0, C, 65535):
        block_y_size = min(C - block_y, 65535)
        for block_z in range(0, B, 65535):
            block_z_size = min(B - block_z, 65535)

            gridSize = (ceil(D_out * H_out * W_out / 256), block_y_size, block_z_size)
            blockSize = min(D_out * H_out * W_out, 256)

            replication_pad_backward_kernel<<<gridSize, blockSize>>>(
                gradInput_, gradOutput_, pfront, ptop, pleft, block_y, block_z)

【备注】
    - 支持 float, complex, half, bfloat16
    - 非确定性操作 (使用原子加)

