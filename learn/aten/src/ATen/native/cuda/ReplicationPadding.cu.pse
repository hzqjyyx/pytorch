--------------------------------
imin, imax (设备端最小/最大值)
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @host @device
    imin(a: int, b: int) -> int
    imax(a: int, b: int) -> int

【算法】
    imin: return a > b ? b : a
    imax: return a > b ? a : b

--------------------------------
replication_pad_forward_kernel1d
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @device
    replication_pad_forward_kernel1d(
        input: Tensor[B, C, W_in],
        output: Tensor[B, C, W_out],
        padL: int,
        y_shift: int,
        z_shift: int
    )

【算法】
    outputPointId = threadIdx.x + blockIdx.x * blockDim.x
    plane = blockIdx.y + y_shift
    batch = blockIdx.z + z_shift

    if outputPointId >= W_out:
        return

    outputPointX = outputPointId

    iStartX = max(0, -padL)
    oStartX = max(0, padL)

    # 将输出坐标映射到输入坐标，边界外复制最近的边界值
    inputPointX = min(max(padL, outputPointX), W_in + padL - 1) - oStartX + iStartX

    output[batch][plane][outputPointX] = input[batch][plane][inputPointX]

【并行模式】
    elementwise
    grid: (ceil(W_out/256), C_blocks, B_blocks)
    block: (min(W_out, 256))

--------------------------------
replication_pad_backward_kernel (1D版本)
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @device
    replication_pad_backward_kernel(
        gradInput: Tensor[B, C, W_in],
        gradOutput: Tensor[B, C, W_out],
        padL: int,
        y_shift: int,
        z_shift: int
    )

【算法】
    outputPointId = threadIdx.x + blockIdx.x * blockDim.x
    plane = blockIdx.y + y_shift
    batch = blockIdx.z + z_shift

    if outputPointId >= W_out:
        return

    outputPointX = outputPointId

    iStartX = max(0, -padL)
    oStartX = max(0, padL)

    inputPointX = min(max(padL, outputPointX), W_in + padL - 1) - oStartX + iStartX

    atomic_add(gradInput[batch][plane][inputPointX], gradOutput[batch][plane][outputPointX])

【并行模式】
    atomic_add (多个输出点可能映射到同一输入点)

--------------------------------
replication_pad_forward_kernel2d
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @device
    replication_pad_forward_kernel2d(
        input: Tensor[B, C, H_in, W_in],
        output: Tensor[B, C, H_out, W_out],
        padT: int,
        padL: int,
        y_shift: int,
        z_shift: int
    )

【算法】
    outputPointId = threadIdx.x + blockIdx.x * blockDim.x
    plane = blockIdx.y + y_shift
    batch = blockIdx.z + z_shift

    if outputPointId >= H_out * W_out:
        return

    outputPointX = outputPointId % W_out
    outputPointY = outputPointId / W_out

    iStartX = max(0, -padL)
    iStartY = max(0, -padT)
    oStartX = max(0, padL)
    oStartY = max(0, padT)

    inputPointX = min(max(padL, outputPointX), W_in + padL - 1) - oStartX + iStartX
    inputPointY = min(max(padT, outputPointY), H_in + padT - 1) - oStartY + iStartY

    output[batch][plane][outputPointY][outputPointX] = input[batch][plane][inputPointY][inputPointX]

【并行模式】
    elementwise
    grid: (ceil(H_out*W_out/256), C_blocks, B_blocks)
    block: (min(H_out*W_out, 256))

