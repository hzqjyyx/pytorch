    iStartX = max(0, -padL)
    iStartY = max(0, -padT)
    oStartX = max(0, padL)
    oStartY = max(0, padT)

    inputPointX = min(max(padL, outputPointX), W_in + padL - 1) - oStartX + iStartX
    inputPointY = min(max(padT, outputPointY), H_in + padT - 1) - oStartY + iStartY

    atomic_add(gradInput[batch][plane][inputPointY][inputPointX], 
               gradOutput[batch][plane][outputPointY][outputPointX])

