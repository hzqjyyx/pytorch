replication_pad_backward_kernel (3D版本)
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @device
    replication_pad_backward_kernel(
        gradInput: Tensor[B, C, D_in, H_in, W_in],
        gradOutput: Tensor[B, C, D_out, H_out, W_out],
        pfront: int,
        ptop: int,
        pleft: int,
        y_shift: int,
        z_shift: int
    )

【算法】
    outputPointId = threadIdx.x + blockIdx.x * blockDim.x
    plane = blockIdx.y + y_shift
    batch = blockIdx.z + z_shift

    if outputPointId >= D_out * H_out * W_out:
        return

    outputPointX = outputPointId % W_out
    outputPointY = (outputPointId / W_out) % H_out
    outputPointZ = outputPointId / (H_out * W_out)

    iStartX = max(0, -pleft)
    iStartY = max(0, -ptop)
    iStartZ = max(0, -pfront)
    oStartX = max(0, pleft)
    oStartY = max(0, ptop)
    oStartZ = max(0, pfront)

    inputPointX = min(max(pleft, outputPointX), W_in + pleft - 1) - oStartX + iStartX
    inputPointY = min(max(ptop, outputPointY), H_in + ptop - 1) - oStartY + iStartY
    inputPointZ = min(max(pfront, outputPointZ), D_in + pfront - 1) - oStartZ + iStartZ

    atomic_add(gradInput[batch][plane][inputPointZ][inputPointY][inputPointX],
               gradOutput[batch][plane][outputPointZ][outputPointY][outputPointX])

【并行模式】
    atomic_add

--------------------------------
replication_pad2d_backward_out_cuda_template
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @host→device
    replication_pad2d_backward_out_cuda_template(
        gradInput: Tensor[?, ?, H_in, W_in],
        gradOutput: Tensor[?, ?, H_out, W_out],
        input: Tensor[?, ?, H_in, W_in],
        paddingSize: [padL, padR, padT, padB]
    )

【算法】
    # 验证输入
    assert at::cuda::detail::canUse32BitIndexMath(input)
    assert at::cuda::detail::canUse32BitIndexMath(gradOutput)
    assert paddingSize.size == 4

    padL, padR, padT, padB = paddingSize
    dimh = 1 if input.dim == 3 else 2
    dimw = 2 if input.dim == 3 else 3

    H_in = input.size(dimh)
    W_in = input.size(dimw)
    H_out = H_in + padT + padB
    W_out = W_in + padL + padR

    assert W_out == gradOutput.size(dimw)
    assert H_out == gradOutput.size(dimh)

    gradInput.resize_as_(input)
    if gradInput.numel == 0:
        return

    gradInput.zero_()

    # 添加batch维度(如果是3D输入)
    if input.dim == 3:
        gradInput_ = gradInput.unsqueeze(0)
        gradOutput_ = gradOutput.unsqueeze(0)
    else:
        gradInput_ = gradInput
        gradOutput_ = gradOutput

    B = gradOutput_.size(0)
    C = gradOutput_.size(1)

    # 分块处理以避免超过CUDA grid限制 (65535)
    for block_y in range(0, C, 65535):
        block_y_size = min(C - block_y, 65535)
        for block_z in range(0, B, 65535):
            block_z_size = min(B - block_z, 65535)

            gridSize = (ceil(H_out * W_out / 256), block_y_size, block_z_size)
            blockSize = min(H_out * W_out, 256)

            replication_pad_backward_kernel<<<gridSize, blockSize>>>(
                gradInput_, gradOutput_, padT, padL, block_y, block_z)

【备注】
    - 支持 float, complex, half, bfloat16
    - 非确定性操作 (使用原子加)

--------------------------------
shapeAndGradOutputCheck3d
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    shapeAndGradOutputCheck3d(
        input: Tensor[?, C, D_in, H_in, W_in],
        gradOutput: Tensor[?, C, D_out, H_out, W_out],
        pleft: int, pright: int,
        ptop: int, pbottom: int,
        pfront: int, pback: int
    )

【算法】
    assert at::cuda::detail::canUse32BitIndexMath(input)
    
    numInputDims = input.dim
    assert numInputDims in [4, 5]
    assert input.size(1) != 0 and input.size(2) != 0 and input.size(3) != 0
    if numInputDims == 5:
        assert input.size(4) != 0

    planeDim = 0 if numInputDims == 4 else 1
    dimd = 1 if numInputDims == 4 else 2
    dimh = 2 if numInputDims == 4 else 3
    dimw = 3 if numInputDims == 4 else 4

    C = input.size(planeDim)
    D_in = input.size(dimd)
    H_in = input.size(dimh)
    W_in = input.size(dimw)
    D_out = D_in + pfront + pback
    H_out = H_in + ptop + pbottom
    W_out = W_in + pleft + pright

    assert W_out >= 1 and H_out >= 1 and D_out >= 1
    assert at::cuda::detail::canUse32BitIndexMath(gradOutput)
    assert C == gradOutput.size(planeDim)
    assert W_out == gradOutput.size(dimw)
    assert H_out == gradOutput.size(dimh)
    assert D_out == gradOutput.size(dimd)

