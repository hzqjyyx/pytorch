replication_pad1d_out_cuda
来源: aten/src/ATen/native/cuda/ReplicationPadding.cu
--------------------------------

【签名】
    @host→device
    replication_pad1d_out_cuda(
        input: Tensor[?, C, W_in],
        paddingSize: [padL, padR],
        output: Tensor[?, C, W_out]
    )

    约束:
    - input.numel < 2^63 - 1
    - W_out = W_in + padL + padR

【算法】
    if input.numel == 0:
        return

    padL = paddingSize[0]

    # 添加batch维度(如果是2D输入)
    if input.dim == 2:
        input_ = input.unsqueeze(0)
        output_ = output.unsqueeze(0)
    else:
        input_ = input
        output_ = output

    B = output_.size(0)
    C = output_.size(1)
    W_out = output_.size(2)

    # 分块处理以避免超过CUDA grid限制
    for block_y in range(0, C, 65535):
        block_y_size = min(C - block_y, 65535)
        for block_z in range(0, B, 65535):
            block_z_size = min(B - block_z, 65535)

            gridSize = (ceil(W_out / 256), block_y_size, block_z_size)
            blockSize = min(W_out, 256)

            replication_pad_forward_kernel1d<<<gridSize, blockSize>>>(
                input_, output_, padL, block_y, block_z)

【备注】
    - 支持所有类型，包括 complex, half, bfloat16

