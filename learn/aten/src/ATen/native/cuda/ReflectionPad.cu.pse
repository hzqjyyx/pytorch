--------------------------------
reflection_pad3d_out_cuda
来源: aten/src/ATen/native/cuda/ReflectionPad.cu
--------------------------------

【签名】
    @host→device
    reflection_pad3d_out_cuda(
        input: Tensor[*, D, H, W],
        padding: [pad_l, pad_r, pad_t, pad_b, pad_front, pad_back],
        output: Tensor
    ) -> Tensor

【算法】
    if output.numel() == 0:
        return

    pad_left = padding[0]
    pad_top = padding[2]
    pad_front = padding[4]

    input = input.contiguous()
    batch_mode = (input.dim() == 5)

    # 非batch模式添加batch维度
    if not batch_mode:
        input = input.unsqueeze(0)
        output = output.unsqueeze(0)

    input_packed = input.packed_accessor64<scalar_t, 5>()
    output_packed = output.packed_accessor64<scalar_t, 5>()

    output_plane_size = output_packed.size(2) * output_packed.size(3) * output_packed.size(4)
    size_y = input_packed.size(1)  # channels
    size_z = input_packed.size(0)  # batch
    block_size = min(output_plane_size, 256)

    # 分块处理大batch/channel
    for block_y in range(0, size_y, 65535):
        block_y_size = min(size_y - block_y, 65535)
        for block_z in range(0, size_z, 65535):
            block_z_size = min(size_z - block_z, 65535)

            grid_size = (ceil(output_plane_size/256), block_y_size, block_z_size)
            reflection_pad3d_out_kernel<<<grid_size, block_size>>>(
                input_packed, output_packed,
                pad_left, pad_top, pad_front,
                block_y, block_z
            )

【备注】
    - 支持4D (C,D,H,W) 和 5D (N,C,D,H,W) 输入
    - 使用AT_DISPATCH_ALL_TYPES_AND_COMPLEX_AND2(kHalf, kBFloat16)

--------------------------------
reflection_pad3d_backward_out_cuda
来源: aten/src/ATen/native/cuda/ReflectionPad.cu
--------------------------------

【签名】
    @host→device
    reflection_pad3d_backward_out_cuda(
        grad_output: Tensor[*, output_d, output_h, output_w],
        input: Tensor[*, D, H, W],
        padding: [pad_l, pad_r, pad_t, pad_b, pad_front, pad_back],
        grad_input: Tensor[*, D, H, W]
    ) -> Tensor

【算法】
    if grad_input.numel() == 0:
        return

    grad_input.zero_()

    pad_left = padding[0]
    pad_top = padding[2]
    pad_front = padding[4]

    # 非batch模式添加batch维度
    grad_input_ = grad_input
    grad_output_ = grad_output
    if input.dim() == 4:
        grad_input_ = grad_input.unsqueeze(0)
        grad_output_ = grad_output.unsqueeze(0)

    grad_input_packed = grad_input_.packed_accessor64<scalar_t, 5>()
    grad_output_packed = grad_output_.packed_accessor64<scalar_t, 5>()

    output_plane_size = grad_output_packed.size(2) * grad_output_packed.size(3) * grad_output_packed.size(4)
    size_y = grad_input_packed.size(1)
    size_z = grad_input_packed.size(0)
    block_size = min(output_plane_size, 256)

    # 分块处理大batch/channel
    for block_y in range(0, size_y, 65535):
        block_y_size = min(size_y - block_y, 65535)
        for block_z in range(0, size_z, 65535):
            block_z_size = min(size_z - block_z, 65535)

            grid_size = (ceil(output_plane_size/256), block_y_size, block_z_size)
            reflection_pad3d_backward_out_kernel<<<grid_size, block_size>>>(
                grad_input_packed, grad_output_packed,
                pad_left, pad_top, pad_front,
                block_y, block_z
            )

【备注】
    - 使用原子操作，非确定性
    - 使用AT_DISPATCH_FLOATING_AND_COMPLEX_TYPES_AND2(kHalf, kBFloat16)
