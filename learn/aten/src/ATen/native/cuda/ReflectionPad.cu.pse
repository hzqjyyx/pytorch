--------------------------------
get_index_mapping1d
来源: aten/src/ATen/native/cuda/ReflectionPad.cu
--------------------------------

【签名】
    @device
    get_index_mapping1d(
        input_w: int64,
        output_w: int64,
        output_x: int64,
        pad_l: int64
    ) -> (input_index: int64, output_index: int64)

【算法】
    # 计算当前线程在3D grid中的输入/输出偏移
    input_offset = (blockIdx.y + blockIdx.z * gridDim.y) * input_w
    output_offset = (blockIdx.y + blockIdx.z * gridDim.y) * output_w

    # 计算有效起始位置
    i_start_x = max(0, -pad_l)
    o_start_x = max(0, pad_l)

    # 反射映射公式
    input_x = abs(output_x - pad_l) 
              - abs(output_x - (input_w + pad_l - 1)) 
              - output_x 
              + 2*pad_l + input_w - 1 
              - o_start_x + i_start_x

    return (input_offset + input_x, output_offset + output_x)

【备注】
    - 反射映射公式处理边界折叠逻辑
    - 3D grid布局: (x方向, plane方向, batch方向)

--------------------------------
get_index_mapping2d
来源: aten/src/ATen/native/cuda/ReflectionPad.cu
--------------------------------

【签名】
    @device
    get_index_mapping2d(
        input_dim_x: int64, input_dim_y: int64,
        output_dim_x: int64, output_dim_y: int64,
        pad_l: int64, pad_t: int64,
        output_xy: int64,
        y_shift: int, z_shift: int, nplane: int
    ) -> (input_index: int64, output_index: int64)

【算法】
    # 计算偏移
    input_offset = ((blockIdx.y + y_shift) + (blockIdx.z + z_shift) * nplane) * input_dim_x * input_dim_y
    output_offset = ((blockIdx.y + y_shift) + (blockIdx.z + z_shift) * nplane) * output_dim_x * output_dim_y

    # 线性索引转2D坐标
    output_x = output_xy % output_dim_x
    output_y = output_xy / output_dim_x

    # 有效起始位置
    i_start_x = max(0, -pad_l)
    i_start_y = max(0, -pad_t)
    o_start_x = max(0, pad_l)
    o_start_y = max(0, pad_t)

    # x方向反射映射
    input_x = abs(output_x - pad_l) 
              - abs(output_x - (input_dim_x + pad_l - 1)) 
              - output_x 
              + 2*pad_l + input_dim_x - 1 
              - o_start_x + i_start_x

    # y方向反射映射
    input_y = abs(output_y - pad_t) 
              - abs(output_y - (input_dim_y + pad_t - 1)) 
              - output_y 
              + 2*pad_t + input_dim_y - 1 
              - o_start_y + i_start_y

    return (
        input_offset + input_y * input_dim_x + input_x,
        output_offset + output_y * output_dim_x + output_x
    )

【备注】
    - 2D反射映射，x/y方向独立计算
    - 支持分块并行处理大batch/channel

