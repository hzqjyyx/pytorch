reflection_pad1d_out_kernel
来源: aten/src/ATen/native/cuda/ReflectionPad.cu
--------------------------------

【签名】
    @device
    reflection_pad1d_out_kernel<scalar_t>(
        input: Tensor[*, input_w],
        output: Tensor[*, output_w],
        input_w: int64,
        pad_l: int64, pad_r: int64
    )

【算法】
    output_x = threadIdx.x + blockIdx.x * blockDim.x
    output_w = input_w + pad_l + pad_r

    if output_x < output_w:
        (input_idx, output_idx) = get_index_mapping1d(input_w, output_w, output_x, pad_l)
        output[output_idx] = input[input_idx]

【并行模式】
    grid: (ceil(output_w/256), nplane, nbatch)
    block: (min(output_w, 256))
    每线程处理输出的一个元素

