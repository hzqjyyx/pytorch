【签名】
    @device
    reflection_pad2d_out_kernel<scalar_t>(
        input: Tensor[*, input_h, input_w],
        output: Tensor[*, output_h, output_w],
        input_dim_x: int64, input_dim_y: int64,
        pad_t: int, pad_b: int, pad_l: int, pad_r: int,
        y_shift: int, z_shift: int, nplane: int
    )

【算法】
    output_xy = threadIdx.x + blockIdx.x * blockDim.x
    output_dim_x = input_dim_x + pad_l + pad_r
    output_dim_y = input_dim_y + pad_t + pad_b

    if output_xy < output_dim_x * output_dim_y:
        (input_idx, output_idx) = get_index_mapping2d(
            input_dim_x, input_dim_y,
            output_dim_x, output_dim_y,
            pad_l, pad_t,
            output_xy, y_shift, z_shift, nplane
        )
        output[output_idx] = input[input_idx]

【并行模式】
