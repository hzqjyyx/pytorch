--------------------------------
_embedding_bag_cuda
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @host→device
    _embedding_bag_cuda(
        weight: Tensor[numRows, featureSize, float],
        indices: Tensor[numIndices, int|long],
        offsets: Tensor[numBags+?, int|long],
        scale_grad_by_freq: bool,
        mode: int64,
        sparse: bool,
        per_sample_weights: Optional[Tensor[numIndices, float]],
        include_last_offset: bool,
        padding_idx: int64
    ) -> (output: Tensor[numBags, featureSize],
          offset2bag: Tensor[numIndices],
          bag_size: Tensor[numBags],
          max_indices: Tensor[numBags, featureSize] | Tensor[0])

    约束:
    - indices.dim in [1, 2]
    - offsets.dim == 1 (当 indices.dim == 1 时)
    - weight.dim == 2

【算法】
    # Step 1: 类型提升
    indices, offsets = promoteIndicesAndOffsets(indices, offsets)
    
    # Step 2: 计算 numBags
    numBags = offsets.size(0)
    if include_last_offset:
        numBags -= 1
    
    # Step 3: 分配输出
    output = at::empty({numBags, featureSize}, weight.options())
    bag_size = at::empty({numBags}, indices.options())
    offset2bag = at::empty({numIndices}, indices.options())
    
    if mode == EmbeddingBagMode::MAX:
        max_indices = at::empty({numBags, featureSize}, indices.options())
    else:
        max_indices = at::empty({0}, indices.options())
    
    # Step 4: 调度 kernel
    if mode == EmbeddingBagMode::MAX:
        EmbeddingBag_updateOutputKernel_max<<<grid, block>>>(
            indices, offsets, weight, output,
            offset2bag, numIndices, numBags, featureSize,
            weight.stride(0), weight.stride(1),
            bag_size, max_indices, padding_idx, weight.size(0)
        )
    else:
        EmbeddingBag_updateOutputKernel_sum_mean<<<grid, block>>>(
            indices, offsets, weight, output,
            offset2bag, numIndices, numBags, featureSize,
            weight.stride(0), weight.stride(1), mode,
            bag_size,
            per_sample_weights if per_sample_weights.defined() else NULL,
            per_sample_weights.stride(0) if per_sample_weights.defined() else 0,
            padding_idx, weight.size(0)
        )
    
    return (output, offset2bag, bag_size, max_indices)

【并行模式】
    grid: 1024
    block: (32, 8) for CUDA, (64, 4) for ROCm

【备注】
    - mode: EmbeddingBagMode::SUM (0), MEAN (1), MAX (2)
    - include_last_offset: 如果为 true，offsets 的最后一个元素应等于 numIndices
    - offset2bag[i]: 第 i 个 index 属于哪个 bag


--------------------------------
_embedding_bag_dense_backward_cuda
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @host→device
    _embedding_bag_dense_backward_cuda(
        grad: Tensor[numBags, D, float],
        indices: Tensor[N, index_t],
        offset2bag: Tensor[N, index_t],
        bag_size: Tensor[numBags, index_t],
        max_indices: Tensor[numBags, D, index_t] | Tensor[0],
        num_weights: int64,
        scale_grad_by_freq: bool,
        mode: int64,
        per_sample_weights: Optional[Tensor[N, float]],
        padding_idx: int64
    ) -> Tensor[num_weights, D]

【算法】
    grad = grad.contiguous()
    
    match mode:
        EmbeddingBagMode::SUM | EmbeddingBagMode::MEAN:
            return embedding_bag_backward_cuda_sum_avg(
                grad, indices, offset2bag, bag_size,
                num_weights, scale_grad_by_freq, mode,
                per_sample_weights, padding_idx
            )
        
        EmbeddingBagMode::MAX:
            return embedding_bag_backward_cuda_max(
                grad, max_indices, num_weights, padding_idx
            )

【备注】
    - MEAN 模式不支持 per_sample_weights
    - MAX 模式不支持 per_sample_weights


--------------------------------
_embedding_bag_per_sample_weights_backward_kernel
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @device
    _embedding_bag_per_sample_weights_backward_kernel(
        grad: Tensor[num_bags, embedding_features, scalar_t],
        weight: Tensor[num_embeddings, embedding_features, scalar_t],
        indices: Tensor[num_samples, index_t],
        offset2bag: Tensor[num_samples, index_t],
        output: Tensor[num_samples, scalar_t],
        padding_idx: index_t
    )

【算法】
    # 每个 warp 负责计算一个 sample 的梯度
    # 即计算 grad[bag_idx] · weight[embedding_idx]
    
    parallel_for sample_idx in range(num_samples):  # warp级并行
        bag_idx = offset2bag[sample_idx]
        embedding_idx = indices[sample_idx]
        
        if embedding_idx != padding_idx:
            result = 0
            
            for feature_idx in range(embedding_features):  # warp内并行
                result += grad[bag_idx, feature_idx] * weight[embedding_idx, feature_idx]
            
            result = warp_reduce_sum(result)
            
            if thread_in_warp == 0:
                output[sample_idx] = result

【并行模式】
    grid: (num_samples + warps_per_block - 1) / warps_per_block
    block: 512
    
    - 每个 warp 处理一个 sample
    - warp 内并行归约 dot product

【备注】
    - 计算 per_sample_weights 的梯度
    - 使用 warp_reduce 提高效率


--------------------------------
_embedding_bag_per_sample_weights_backward_cuda
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @host→device
    _embedding_bag_per_sample_weights_backward_cuda(
        grad: Tensor[num_bags, embedding_features, float],
        weight: Tensor[num_embeddings, embedding_features, float],
        indices: Tensor[num_samples, index_t],
        offsets: Tensor[num_bags, index_t],
        offset2bag: Tensor[num_samples, index_t],
        mode: int64,
        padding_idx: int64
    ) -> Tensor[num_samples]

    约束:
    - mode == EmbeddingBagMode::SUM
    - grad.dim == 2
    - indices.dim == 1
    - weight.dim == 2
    - weight.size(1) == grad.size(1)

【算法】
    indices, offsets = promoteIndicesAndOffsets(indices, offsets)
    
    num_samples = indices.size(0)
    embedding_features = grad.size(1)
    
    output = at::empty({num_samples}, grad.options())
    
    if num_samples == 0:
        return output
    
    _embedding_bag_per_sample_weights_backward_kernel<<<grid, block>>>(
        grad, weight, indices, offset2bag,
        num_samples, embedding_features,
        output, padding_idx
    )
    
    return output

【备注】
    - 仅支持 SUM 模式
    - 计算 per_sample_weights 参数的梯度
