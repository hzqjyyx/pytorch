--------------------------------
promoteIndicesAndOffsets
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    promoteIndicesAndOffsets(
        indices: Tensor[N, int|long],
        offsets: Tensor[B, int|long]
    ) -> (Tensor[N], Tensor[B])

【算法】
    commonType = promote_types(offsets.dtype, indices.dtype)
    
    indices_promoted = indices if indices.dtype == commonType else indices.to(commonType)
    offsets_promoted = offsets if offsets.dtype == commonType else offsets.to(commonType)
    
    return (indices_promoted, offsets_promoted)

【备注】
    - 确保 indices 和 offsets 使用相同的整数类型 (int32 或 int64)


--------------------------------
EmbeddingBag_updateOutputKernel_max
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @device
    EmbeddingBag_updateOutputKernel_max(
        input: Tensor[numIndices, index_t],
        offsets: Tensor[numBags, index_t],
        weight: Tensor[numRows, featureSize, scalar_t],
        output: Tensor[numBags, featureSize, scalar_t],
        offset2bag: Tensor[numIndices, index_t],
        bag_size: Tensor[numBags, index_t],
        max_indices: Tensor[numBags, featureSize, index_t],
        padding_idx: index_t
    )

【算法】
    # 每个 bag × feature 由一个线程处理
    
    parallel_for chunk in range(numBags * chunksPerBag):
        featureDim = (chunk % chunksPerBag) * blockDim.x + threadIdx.x
        
        if featureDim < featureSize:
            bag = chunk / chunksPerBag
            begin = offsets[bag] if bag > 0 else 0
            end = offsets[bag + 1] if bag < numBags - 1 else numIndices
            
            weightFeatMax = 0
            bag_size_ = 0
            maxWord = -1
            
            for emb in range(begin, end):
                pad = (input[emb] == padding_idx)
                weightValue = weight[input[emb], featureDim]
                
                if bag_size_ == 0 or weightValue > weightFeatMax:
                    weightFeatMax = weightValue if not pad else weightFeatMax
                    maxWord = input[emb] if not pad else maxWord
                
                bag_size_ += 0 if pad else 1
                
                if featureDim == 0:
                    offset2bag[emb] = bag
            
            bag_size[bag] = bag_size_
            max_indices[bag, featureDim] = maxWord
            output[bag, featureDim] = weightFeatMax

【并行模式】
    grid: 1024
    block: (32, 8) for CUDA, (64, 4) for ROCm
    
    - bag × feature 二维并行
    - chunksPerBag = ceil(featureSize / blockDim.x)
    - gridDim.x * blockDim.y 并行处理所有 chunks


--------------------------------
EmbeddingBag_updateOutputKernel_sum_mean
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @device
    EmbeddingBag_updateOutputKernel_sum_mean(
        input: Tensor[numIndices, index_t],
        offsets: Tensor[numBags, index_t],
        weight: Tensor[numRows, featureSize, scalar_t],
        output: Tensor[numBags, featureSize, scalar_t],
        offset2bag: Tensor[numIndices, index_t],
        bag_size: Tensor[numBags, index_t],
        mode: int,
        per_sample_weights: Optional[Tensor[numIndices, scalar_t]],
        padding_idx: index_t
    )

【算法】
    # 每个 bag × feature 由一个线程处理
    
    parallel_for chunk in range(numBags * chunksPerBag):
        featureDim = (chunk % chunksPerBag) * blockDim.x + threadIdx.x
        
        if featureDim < featureSize:
            bag = chunk / chunksPerBag
            begin = offsets[bag] if bag > 0 else 0
            end = offsets[bag + 1] if bag < numBags - 1 else numIndices
            
            weightFeatSum = 0  # 使用累加精度类型
            bag_size_ = 0
            
            for emb in range(begin, end):
                input_idx = input[emb]
                pad = (input_idx == padding_idx)
                weightValue = weight[input_idx, featureDim]
                weightValue = 0 if pad else weightValue
                
                if per_sample_weights is not None:
                    weightFeatSum += per_sample_weights[emb] * weightValue
                else:
                    weightFeatSum += weightValue
                
                bag_size_ += 0 if pad else 1
                
                if featureDim == 0:
                    offset2bag[emb] = bag
            
            if mode == EmbeddingBagMode::MEAN and bag_size_ != 0:
                weightFeatSum = weightFeatSum / bag_size_
            
            bag_size[bag] = bag_size_
            output[bag, featureDim] = weightFeatSum

【并行模式】
    grid: 1024
    block: (32, 8) for CUDA, (64, 4) for ROCm
    
    - bag × feature 二维并行
    - 使用 accscalar_t 累加以保持精度

【备注】
    - mode: EmbeddingBagMode::SUM 或 MEAN
    - per_sample_weights: 可选的每样本权重


--------------------------------
embedding_bag_backward_cuda_sum_avg
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @host→device
    embedding_bag_backward_cuda_sum_avg(
        grad: Tensor[numBags, D, float],
        indices: Tensor[N, index_t],
        offset2bag: Tensor[N, index_t],
        bag_size: Tensor[numBags, index_t],
        num_weights: int64,
        scale_grad_by_freq: bool,
        mode: int64,
        per_sample_weights: Optional[Tensor[N, float]],
        padding_idx: int64
    ) -> Tensor[num_weights, D]

【算法】
    indices = indices.contiguous()
    
    if indices.numel() == 0:
        return at::zeros({num_weights, grad.size(1)}, grad.options())
    
    # Step 1: 对 indices 进行基数排序，同时记录原始位置
    range = at::arange(indices.numel(), indices.options())
    cuda::cub::radix_sort_pairs(
        indices, sorted_indices,
        range, orig_indices,
        indices.numel()
    )
    
    # Step 2: 如果需要按频率缩放梯度
    if scale_grad_by_freq:
        # 计算每个 unique index 的出现次数
        # sorted: 2 5 5 5 7 7 8 9 9
        #  count: 1 3 3 3 2 2 1 2 2
        cuda::cub::inclusive_sum_by_key(sorted_indices, ones, count)
        cuda::cub::inclusive_scan_by_key(
            reverse(sorted_indices),
            reverse(count),
            reverse(count),
            Max()
        )
    
    # Step 3: 计算梯度
    return embedding_backward_cuda_kernel(
        grad, orig_indices, sorted_indices,
        count, num_weights, padding_idx,
        mode == EmbeddingBagMode::MEAN,
        offset2bag, bag_size, per_sample_weights
    )

【备注】
    - embedding_backward_cuda_kernel: 见 EmbeddingBackwardKernel.cuh
    - CUB 排序和扫描操作确保相同 index 的梯度被正确聚合


--------------------------------
EmbeddingBag_accGradParametersKernel_max
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @device
    EmbeddingBag_accGradParametersKernel_max(
        max_indices: Tensor[numBags, stride, index_t],
        gradOutput: Tensor[numBags, stride, scalar_t],
        gradWeight: Tensor[numel, scalar_t],
        stride: int64,
        numBags: int64,
        padding_idx: index_t
    )

【算法】
    parallel_for chunk in range(numBags * chunksPerBag):
        featureDim = (chunk % chunksPerBag) * blockDim.x + threadIdx.x
        
        if featureDim < stride:
            bag = chunk / chunksPerBag
            word_idx = max_indices[bag, featureDim]
            
            if word_idx >= 0 and word_idx != padding_idx:
                atomic_add(
                    gradWeight[word_idx * stride + featureDim],
                    gradOutput[bag, featureDim]
                )

【并行模式】
    grid: 1024
    block: (32, 8) for CUDA, (64, 4) for ROCm
    
    - bag × feature 二维并行
    - 使用 fastAtomicAdd 避免冲突

【备注】
    - 只对前向中选中的 max_indices 累加梯度
    - 空 bag 的 max_indices 为 -1，跳过


--------------------------------
embedding_bag_backward_cuda_max
来源: aten/src/ATen/native/cuda/EmbeddingBag.cu
--------------------------------

【签名】
    @host→device
    embedding_bag_backward_cuda_max(
        grad: Tensor[numBags, D, float],
        max_indices: Tensor[numBags, D, index_t],
        num_weights: int64,
        padding_idx: int64
    ) -> Tensor[num_weights, D]

【算法】
    globalContext().alertNotDeterministic("embedding_bag_backward_cuda_max")
    
    grad_weight = at::zeros({num_weights, grad.size(1)}, grad.options())
    
    EmbeddingBag_accGradParametersKernel_max<<<grid, block>>>(
        max_indices, grad, grad_weight,
        grad_weight.stride(0), grad.size(0), padding_idx, grad_weight.numel()
    )
    
    return grad_weight

【备注】
    - 非确定性操作（原子加）
    - 只对前向选中的 embedding 累加梯度


