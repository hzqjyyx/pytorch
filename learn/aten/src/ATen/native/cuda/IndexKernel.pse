index_elementwise_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @device
    index_elementwise_kernel<nt, vt, func_t>(N: int64, f: func_t)

    模板参数:
    - nt: 每block的线程数
    - vt: 每线程处理的元素数

【算法】
    tid = threadIdx.x
    nv = nt * vt
    idx = nv * blockIdx.x + tid

    for i in range(vt):
        if idx < N:
            f(idx)
            idx += nt

【并行模式】
    grid: (ceil(N / (nt * vt)),)
    block: (nt,)
    - 每个线程处理vt个元素，步长为nt

--------------------------------
launch_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    launch_kernel<nt, vt, func_t>(N: int64, f: func_t)

【算法】
    if N == 0:
        return

    grid = (ceil(N / (nt * vt)),)
    block = (nt,)
    stream = at::cuda::getCurrentCUDAStream()
    index_elementwise_kernel<nt, vt><<<grid, block, 0, stream>>>(N, f)

【备注】
    - nt, vt: 编译期常量，默认使用 launch_size_nd=128, launch_bound2=4

--------------------------------
gpu_index_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    gpu_index_kernel<func_t>(
        iter: TensorIteratorBase,
        index_size: IntArrayRef[num_indices],
        index_stride: IntArrayRef[num_indices],
        f: func_t
    )

    约束:
    - iter.ntensors == num_indices + 2
    - index_size.size == index_stride.size

【算法】
    if iter.numel == 0:
        return

    # Step 1: 处理大于32位索引的情况
    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            gpu_index_kernel(sub_iter, index_size, index_stride, f)
        return

    # Step 2: 准备索引信息
    sizes = [index_size[i] for i in range(num_indices)]
    strides = [index_stride[i] for i in range(num_indices)]
    index_ptrs = [iter.data_ptr(i + 2) for i in range(num_indices)]

    out_ptr = iter.data_ptr(0)
    in_ptr = iter.data_ptr(1)
    offset_calc = make_offset_calculator<3>(iter)

    # Step 3: 启动kernel
    launch_kernel<128, 4>(iter.numel, lambda idx:
        offsets = offset_calc.get(idx)
        out_data = out_ptr + offsets[0]
        in_data = in_ptr + offsets[1]

        # 计算多维索引偏移
        offset = 0
        for i in range(num_indices):
            index = *reinterpret_cast<int64_t*>(index_ptrs[i] + offsets[2])
            assert -sizes[i] <= index < sizes[i]
            if index < 0:
                index += sizes[i]
            offset += index * strides[i]

        f(out_data, in_data, offset)
    )

【并行模式】
    parallel_for idx in range(iter.numel)

【备注】
    - iter: 包含 [output, input, *indices]
    - f: 回调函数，接收 (out_data, in_data, offset)
    - 支持负索引

--------------------------------
index_fill_kernel_impl
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    index_fill_kernel_impl<scalar_t>(
        iter: TensorIterator,
        dim: int64,
        self_dim_size: int64,
        self_dim_stride: int64,
        fill_val: scalar_t
    )

【算法】
    if iter.numel == 0:
        return

    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            index_fill_kernel_impl(sub_iter, dim, self_dim_size, self_dim_stride, fill_val)
        return

    self_ptr = iter.data_ptr(0)
    idx_ptr = iter.data_ptr(1)
    offset_calc = make_offset_calculator<2>(iter)

    launch_kernel<128, 4>(iter.numel, lambda i:
        offsets = offset_calc.get(i)
        self_data = reinterpret_cast<scalar_t*>(self_ptr + offsets[0])
        idx = *reinterpret_cast<int64_t*>(idx_ptr + offsets[1])

        assert idx >= -self_dim_size and idx < self_dim_size
        if idx < 0:
            idx += self_dim_size

        self_data[idx * self_dim_stride] = fill_val
    )

【并行模式】
    parallel_for i in range(iter.numel)

【备注】
    - iter: 包含 [self, indices]
    - 支持负索引

