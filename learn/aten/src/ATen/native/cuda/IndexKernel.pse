index_put_kernel_quantized_cuda
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    index_put_kernel_quantized_cuda(
        iter: TensorIterator,
        index_size: IntArrayRef,
        index_stride: IntArrayRef,
        accumulate: bool,
        scale: double,
        zero_point: int
    )

    约束:
    - accumulate == false

【算法】
    AT_DISPATCH_QINT_AND_SUB_BYTE_TYPES(iter.dtype(), "index_put",
        qmin = min_value<scalar_t::underlying>
        qmax = max_value<scalar_t::underlying>
        inv_scale = 1.0 / float(scale)

        gpu_index_kernel(iter, index_size, index_stride,
            lambda (out_data, in_data, offset):
                qvalue = int64(zero_point + round(*(float*)in_data * inv_scale))
                qvalue = clamp(qvalue, qmin, qmax)
                *(scalar_t*)(out_data + offset) = scalar_t(qvalue)
        )
    )

【备注】
    - 量化版本的index_put
    - 输入为float，输出为量化类型
    - 使用手动clamp而非std::clamp以避免ROCm构建问题

--------------------------------
cuda_take_put_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    cuda_take_put_kernel<scalar_t, index_t, func_t>(
        iter: TensorIterator,
        indexed: TensorBase,
        f: func_t
    )

【算法】
    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            cuda_take_put_kernel<scalar_t, index_t>(sub_iter, indexed, f)
        return

    numel = indexed.numel()
    is_contiguous = indexed.is_contiguous()

    iterated_ptr = iter.data_ptr(0)
    idx_ptr = iter.data_ptr(1)
    offset_calc = make_offset_calculator<2>(iter)

    # 为非连续tensor准备offset计算器
    indexed_sizes = reversed(indexed.sizes())
    indexed_strides = reversed(indexed.strides())
    offset_indexed = OffsetCalculator<1, unsigned_index_t>(indexed.dim, indexed_sizes, indexed_strides)

    launch_kernel<128, 4>(iter.numel, lambda i:
        offsets = offset_calc.get(i)
        iterated = *reinterpret_cast<scalar_t*>(iterated_ptr + offsets[0])
        idx = *reinterpret_cast<int64_t*>(idx_ptr + offsets[1])

        assert idx < numel and idx >= -numel
        offset = index_t(idx)
        if offset < 0:
            offset += numel

        if not is_contiguous:
            offset = offset_indexed.get(offset)[0]

        f(iterated, offset)
    )

【并行模式】
    parallel_for i in range(iter.numel)

【备注】
    - f: 回调函数，接收 (iterated, offset)
    - index_t: Int 或 Long，取决于tensor大小

--------------------------------
put_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    put_kernel(
        iter: TensorIterator,
        output: TensorBase,
        accumulate: bool
    )

【算法】
    AT_DISPATCH_ALL_TYPES_AND_COMPLEX_AND3(Half, Bool, BFloat16, iter.dtype(), "put_cuda",
        AT_DISPATCH_INDEX_TYPES(can_use_32bit ? Int : Long, "put_cuda_index",
            indexed_ptr = output.data_ptr<scalar_t>()

            if accumulate:
                numel = output.numel()
                cuda_take_put_kernel<scalar_t, index_t>(iter, output,
                    lambda (iterated, offset):
                        fastSpecializedAtomicAdd(indexed_ptr, offset, numel, iterated)
                )
            else:
                cuda_take_put_kernel<scalar_t, index_t>(iter, output,
                    lambda (iterated, offset):
                        indexed_ptr[offset] = iterated
                )
        )
    )

【备注】
    - accumulate=true: 使用原子加
    - accumulate=false: 直接赋值

