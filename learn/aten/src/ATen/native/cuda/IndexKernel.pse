index_copy_kernel_impl
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    index_copy_kernel_impl<scalar_t>(
        iter: TensorIterator,
        dim: int64,
        self_dim_size: int64,
        self_dim_stride: int64
    )

【算法】
    if iter.numel == 0:
        return

    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            index_copy_kernel_impl<scalar_t>(sub_iter, dim, self_dim_size, self_dim_stride)
        return

    self_ptr = iter.data_ptr(0)
    idx_ptr = iter.data_ptr(1)
    source_ptr = iter.data_ptr(2)
    offset_calc = make_offset_calculator<3>(iter)

    launch_kernel<128, 4>(iter.numel, lambda i:
        offsets = offset_calc.get(i)
        self_data = reinterpret_cast<scalar_t*>(self_ptr + offsets[0])
        idx = *reinterpret_cast<int64_t*>(idx_ptr + offsets[1])
        source_data = reinterpret_cast<scalar_t*>(source_ptr + offsets[2])

        assert idx >= 0 and idx < self_dim_size
        self_data[idx * self_dim_stride] = *source_data
    )

【并行模式】
    parallel_for i in range(iter.numel)

【备注】
    - iter: 包含 [self, indices, source]
    - 不支持负索引（与index_fill不同）
    - 非确定性操作（当indices有重复时）

