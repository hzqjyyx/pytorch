【签名】
    @host→device
    flip_kernel_impl<scalar_t>(iter: TensorIterator)

【算法】
    if not iter.can_use_32bit_indexing():
        for sub_iter in iter.with_32bit_indexing():
            flip_kernel_impl<scalar_t>(sub_iter)
        return

    out_ptr = iter.data_ptr(0)
    in_ptr = iter.data_ptr(1)
    offset_calc = make_offset_calculator<2, signed_strides=true>(iter)

    launch_kernel<128, 4>(iter.numel, lambda i:
        offsets = offset_calc.get(i)
        out_data = reinterpret_cast<scalar_t*>(out_ptr + offsets[0])
        in_data = reinterpret_cast<scalar_t*>(in_ptr + offsets[1])
        *out_data = *in_data
    )

