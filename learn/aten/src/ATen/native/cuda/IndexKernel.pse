--------------------------------
launch_masked_scatter_kernel
来源: aten/src/ATen/native/cuda/IndexKernel.cu
--------------------------------

【签名】
    @host→device
    launch_masked_scatter_kernel(
        self: TensorBase[*D, dtype],
        mask: TensorBase[*D, bool],
        maskPrefixSum: TensorBase[*D, int64],
        source: TensorBase[S, dtype]
    )

【算法】
    srcSize = source.numel()
    mask_cont = mask.contiguous()
    mask_numel = mask.numel()

    # Step 1: 计算mask的前缀和（exclusive sum）
    maskPrefixSum_data = maskPrefixSum.mutable_data_ptr<int64_t>()
    mask_data = mask_cont.const_data_ptr<bool>()
    at::cuda::cub::mask_exclusive_sum(mask_data, maskPrefixSum_data, mask_numel)

    # Step 2: 异步检查source大小是否足够
    masked_scatter_size_check<<<1, 1>>>(
        &maskPrefixSum_data[mask_numel - 1],
        &mask_data[mask_numel - 1],
        srcSize
    )

    # Step 3: 执行scatter
    source_contig = source.contiguous()
    iter = TensorIteratorConfig()
        .set_check_mem_overlap(false)
        .check_all_same_dtype(false)
        .resize_outputs(false)
        .add_output(self)
        .add_input(self)
        .add_const_input(mask_cont)
        .add_input(maskPrefixSum)
        .build()

    AT_DISPATCH_ALL_TYPES_AND_COMPLEX_AND3(Bool, BFloat16, Half, self.dtype(), "masked_scatter_",
        source_ptr = source_contig.const_data_ptr<scalar_t>()
        gpu_kernel(iter, lambda (a, mask, maskPrefixSum):
            if mask:
                return source_ptr[maskPrefixSum]
            else:
                return a
        )
    )

【并行模式】
    elementwise

【备注】
    - maskPrefixSum: exclusive prefix sum，表示当前位置之前有多少个true
    - 使用前缀和将mask位置映射到source索引

